// Codespaces/Dev Containers для локальной разработки прототипа.
//
// Вариант "поверх compose" (dockerComposeFile) не выбран сознательно: он
// потребовал бы переписывать docker-compose.yml под devcontainer-специфичный
// сервис "app", хотя файл и так уже рабочий для обычного docker compose.
// Вместо этого — обычный образ + Docker-in-Docker, а docker-compose.yml
// запускается изнутри контейнера тем же способом, что и на машине
// разработчика (post-create.sh).
{
  "name": "vodokanal-assistant",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // 8000  — FastAPI + демо-стенд (app/main.py)
  // 5432  — postgres (слепки Биллинга/ЛК/обращений, шаг 0)
  // 6379  — redis (квоты и сессии, шаг 4)
  // 11434 — Ollama (локальная тестовая модель, шаг 0.5)
  "forwardPorts": [8000, 5432, 6379, 11434],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker"
      ]
    }
  }
  // Секреты (YANDEX_API_KEY и т.п.) сюда не кладутся: задаются через
  // Settings → Secrets and variables → Codespaces репозитория/аккаунта и
  // приходят как обычные переменные окружения — app/config.py их читает
  // напрямую, без .env (см. AI_docs/контекст_4.md, раздел про секреты).
}
