.env
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Настройка запуска для средств разработки: у каждого своя, к проекту не
# относится — тот же класс, что .venv.
.claude/

# Данные и веса моделей в репозиторий не кладутся
fixtures/*.csv
models/
*.gguf

# Готовые бланки заявлений: собираются на лету из данных абонента (ФИО, лицевой
# счёт, адрес), живут ограниченный срок. Дубль объектного хранилища S3/MinIO.
.documents/

# Эталонный набор: разметка кладётся в репозиторий, собранный набор — нет.
# В `retrieval.json` подставлены настоящие тексты обращений, и на них то же
# правило, что и на `fixtures/`: решение вносить их в историю git принимает
# владелец данных, а не скрипт. В `labels.json` текстов нет — только номера
# строк и ожидаемые фрагменты, поэтому он под версионным контролем.
golden_set/retrieval.json

# База знаний: сгенерированное и выгруженное не кладём, а корпус из открытых
# источников — кладём. Он публичный, маленький и пересобирается скриптом
# `scripts/fetch_faq.py`; без него не воспроизвести ни поиск, ни его замеры.
kb/*
!kb/*.json

# --- Документация в AI_docs ---------------------------------------------------
# Резервные копии draw.io: создаются редактором при сохранении и дублируют
# содержимое основного файла.
AI_docs/.$*
*.bkp

# Посторонний файл, попавший в пакет сдачи (пункт 26 сведённого TODO —
# «гигиена пакета сдачи»). В историю не берётся: 954 КБ без назначения.
# Когда решите, нужен он или нет, — удалите файл и эту строку.
AI_docs/C3/test1.png

# LibreOffice lock files
.~lock.*#
