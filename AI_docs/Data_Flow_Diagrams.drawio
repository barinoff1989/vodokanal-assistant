<mxfile host="app.diagrams.net" version="29.0.3"><diagram id="data-architecture-training" name="Архитектура данных — Обучение / индексация (офлайн)">
    <mxGraphModel dx="1212" dy="736" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Архитектура данных — Обучение / индексация (офлайн-контур)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="2000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;font color=&quot;#3C7FC0&quot;&gt;&lt;b&gt;〈BATCH〉&lt;/b&gt;&lt;/font&gt; — периодическая пакетная обработка (расписание) &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#7A3EA1&quot;&gt;&lt;b&gt;〈STREAM〉&lt;/b&gt;&lt;/font&gt; — обработка события сразу, в реальном времени" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="2070" y="18" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="row1lbl" value="1. ИНДЕКСАЦИЯ БАЗЫ ЗНАНИЙ — данные становятся доступны модели через поиск" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#707070;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="800" height="24" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;Документные источники&lt;/b&gt;&lt;br&gt;[Внешние системы · &lt;font color=&quot;#3C7FC0&quot;&gt;〈BATCH〉&lt;/font&gt;]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Инструкции по биллингу (Word); инструкции по общению с абонентом (Word); реестр договоров ВС/ВО (файлы по типу обращения); публичный FAQ и сайт/соцсети водоканала&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;ETL Worker — Ingest&lt;/b&gt;&lt;br&gt;[Контейнер, существующий · &lt;font color=&quot;#3C7FC0&quot;&gt;〈BATCH〉&lt;/font&gt;]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Планировщик Celery Beat, курсор last_modified — периодический опрос документных источников: инструмент выбран под редкие, некритичные по задержке обновления&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="90" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;Data Lake — Raw Zone&lt;/b&gt;&lt;br&gt;[Хранилище: S3 / MinIO]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;〔предложение〕 та же технология, что уже применяется для резервного копирования системы — хранит необработанные документы до трансформации&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D79B00;strokeColor=#B57E00;fontColor=#FFFFFF;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="810" y="90" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="cbox" value="ГДЕ ОЧИСТКА" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#B57E00;strokeWidth=1.6;dashed=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#8A5A00;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="40" width="440" height="410" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;Document Reader + Metadata Enricher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Парсинг HTML/PDF/DOCX; трёхуровневая классификация обращения: правила → эмбеддинг → LLM-классификатор как резервный вариант&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1110" y="82" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Text Splitter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Чанки около 800 токенов; границы по заголовкам документа, не разрывают предложения&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1110" y="225" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Quality &amp;amp; Dedup Filter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Отсев малоинформативных фрагментов; поиск почти-дублей (MinHash/SimHash); оценка качества каждого чанка&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1110" y="340" width="380" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ebox" value="ГДЕ ЭМБЕДДИНГИ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F0E5;strokeColor=#3C7FC0;strokeWidth=1.6;dashed=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#2E7D5B;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1550" y="40" width="400" height="410" as="geometry" />
        </mxCell>
        <mxCell id="e1n" value="&lt;b&gt;Offline Reranker Client&lt;/b&gt;&lt;br&gt;[&lt;font color=&quot;#3C7FC0&quot;&gt;〈BATCH〉&lt;/font&gt;]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Кросс-энкодер BGE-reranker-v2-m3 отбирает представительный чанк внутри кластера почти-дублей перед индексацией.&lt;br&gt;&lt;b&gt;〔ОТКРЫТО — находка F9〕&lt;/b&gt; Модель обучена на паре «запрос ↔ документ», а здесь запроса нет. Вероятно дешевле закрыть уже посчитанным quality_score или центроидным сходством — нужен ADR (раздел 26.5, п. 3). Онлайн-роль реранкера при этом решена (ADR-007)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1580" y="105" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e2n" value="&lt;b&gt;Embedding Client — документы&lt;/b&gt;&lt;br&gt;[&lt;font color=&quot;#3C7FC0&quot;&gt;〈BATCH〉&lt;/font&gt;, GPU]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Тяжёлые прогоны — только в окне 02:00–05:00 (ADR-005).&lt;/b&gt; Батчи по 32–64 чанка → GPU-инференс эмбеддингов (модель BGE-M3): пакетная обработка даёт пропускную способность, задержка одного документа не критична&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1570" y="260" width="340" height="120" as="geometry" />
        </mxCell>

        <mxCell id="v1" value="&lt;b&gt;Vector DB — Qdrant&lt;/b&gt;&lt;br&gt;[Хранилище]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;HNSW (m=16, ef=128); upsert новых векторов с удалением устаревших; переключение на обновлённый индекс без остановки поиска.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;→ здесь данные впервые становятся доступны модели: retrieval + LLM читают этот индекс при каждом ответе (см. схему онлайн-инференса)&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2040" y="60" width="280" height="200" as="geometry" />
        </mxCell>

        <mxCell id="row2lbl" value="2. ПОСТРОЕНИЕ ПРОФИЛЯ АБОНЕНТА (Feature Store) — предотвращение Training-Serving Skew" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#707070;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;Биллинг + Диспетчерская&lt;/b&gt;&lt;br&gt;[Внешние системы · &lt;font color=&quot;#3C7FC0&quot;&gt;〈BATCH〉&lt;/font&gt; для этой ветки]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;БД Биллинга (Postgres): задолженность, показания приборов, дата поверки. Диспетчерская: статус аварийной заявки, зона&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="billing_access" value="&lt;b&gt;Внешний XML-RPC API Биллинга&lt;/b&gt;&lt;br&gt;[интерфейс системы-владельца]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;[ИСПРАВЛЕНО v4.5]&lt;/b&gt; Ранее здесь был наш контейнер-слой с прямым SQL — отменён поправкой к разделу 29.5 и ADR-003. У Биллинга есть собственный внешний XML-RPC API, и это единственный способ доступа. Тот же API используется на онлайн-инференсе правды для обеих сторон&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D79B00;strokeColor=#B57E00;fontColor=#FFFFFF;fontSize=12;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="360" y="520" width="290" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cronjob" value="&lt;b&gt;K8s CronJob&lt;/b&gt;&lt;br&gt;[Оркестратор, принято · &lt;font color=&quot;#3C7FC0&quot;&gt;〈BATCH〉&lt;/font&gt;]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Периодическая материализация — тот же примитив, что уже используется для резервного копирования, без Airflow&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="540" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="&lt;b&gt;Кэш профиля абонента&lt;/b&gt;&lt;br&gt;[Хранилище: Postgres MV + Redis]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;НЕ формальный Feature Store (Feast/Tecton) — материализованная таблица плюс быстрый слой Redis поверх неё.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Роль против Training-Serving Skew:&lt;/b&gt; эту же таблицу читает и офлайн-оценка (Data Scientist), и онлайн-инференс (Backend) — один код, одно определение признака, а не два независимо считающих места&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D79B00;strokeColor=#B57E00;fontColor=#FFFFFF;fontSize=12;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="980" y="510" width="340" height="200" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="&lt;b&gt;ClickHouse&lt;/b&gt;&lt;br&gt;[Хранилище]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Аналитика токенов и стоимости LLM-запросов; метрики качества сервиса — доля отказов, уверенность ответа&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2040" y="330" width="280" height="130" as="geometry" />
        </mxCell>

        <mxCell id="row3lbl" value="3. КОРПУС ДЛЯ ДООБУЧЕНИЯ — поставка данных до границы модели (сам процесс обучения — вне этой схемы)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#707070;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="1000" height="24" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="&lt;b&gt;AI-виджет — события&lt;/b&gt;&lt;br&gt;[Внешний источник · &lt;font color=&quot;#7A3EA1&quot;&gt;〈STREAM〉&lt;/font&gt;]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;〔ОТЛОЖЕНО ДО ЭТАПА 3〕&lt;/b&gt; Redis Streams. На Этапе 1 потребителя в реальном времени нет: квоты закрывает Quota Manager, диалоги пишутся в Session State Store, аналитика идёт батчем в ClickHouse (раздел 30, правка P1-2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="785" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;Обучающий материал&lt;/b&gt;&lt;br&gt;[Внешние/внутренние источники · &lt;font color=&quot;#3C7FC0&quot;&gt;〈BATCH〉&lt;/font&gt;]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;История диалогов абонента с ботом; расшифровки звонков колл-центра; история письменных обращений; курируемый эталонный датасет вопрос-ответ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;PII Filter&lt;/b&gt;&lt;br&gt;[Существующий компонент]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Presidio и распознаватели СНИЛС/ИНН/лицевого счёта/телефона/email — тот же фильтр, что закрывает запросы к внешнему провайдеру LLM на инференсе&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#333333;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="380" y="850" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;Курируемый корпус&lt;/b&gt;&lt;br&gt;[Хранилище: S3 / MinIO, версионируемый]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Обезличенные данные, готовые к дообучению.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Граница этой схемы:&lt;/b&gt; дальше — сам процесс дообучения (LoRA, Этап 3, по триггерам объёма/задержки/требований ИБ) — он не про поставку данных, здесь не показан&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D79B00;strokeColor=#B57E00;fontColor=#FFFFFF;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="710" y="860" width="320" height="180" as="geometry" />
        </mxCell>

        <mxCell id="k2" value="&lt;b&gt;Data Scientist / Annotator&lt;/b&gt;&lt;br&gt;[Внешний контур, техническая роль]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Офлайн-оценка: доля релевантных источников в топ-3, отслеживание деградации модели, курирование эталонного датасета&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2410" y="330" width="250" height="230" as="geometry" />
        </mxCell>

        <!-- Edges row 1 -->
        <mxCell id="ed1" value="извлечение (батч)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="n1">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed2" value="загрузка сырых файлов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n1" target="d1">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed3" value="парсинг и тегирование" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="c1">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed6" value="отбор представит. чанка" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="e1n">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;" edge="1" parent="1" source="e1n" target="e2n">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed8" value="запись векторов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e2n" target="v1">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Edges row 2 -->
        <mxCell id="ed9" value="запрос через API владельца (XML-RPC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="billing_access">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed10" value="запуск по расписанию" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="billing_access" target="cronjob">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed11" value="запись агрегата" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cronjob" target="v2">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Edges row 3 -->
        <mxCell id="ed12" value="батч" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="t2" target="t3">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed12b" value="поток событий" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="t1" target="t3">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed13" value="обезличенные данные" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="t3" target="t4">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Consumer edges -->
        <mxCell id="ed15" value="снимок индекса на момент вопроса" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;dashed=1;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v1" target="k2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="2380" y="165" /></Array>
          </mxGeometry></mxCell>
        <mxCell id="ed16" value="снимок профиля" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;dashed=1;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v2" target="k2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="2350" y="600" /><mxPoint x="2350" y="450" /></Array>
          </mxGeometry></mxCell>
        <mxCell id="ed17" value="курирование" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="t4" target="k2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="2380" y="930" /></Array>
          </mxGeometry></mxCell>
        <mxCell id="ed18" value="метрики качества" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;dashed=1;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v3" target="k2">
          <mxGeometry relative="1" as="geometry" /></mxCell>

      <mxCell id="n_adr3_exception" value="&lt;b&gt;〔ОТКРЫТО — исключение ADR-003〕 Как выгружаются источники 3 и 10&lt;/b&gt;&lt;br&gt;История письменных обращений (источник 3) и расшифровки колл-центра (источник 10) принадлежат &lt;b&gt;чужим системам&lt;/b&gt;. ADR-003 запрещает прямое чтение чужих БД, а способ выгрузки здесь не определён.&lt;br&gt;&lt;br&gt;Допустимы только три варианта:&lt;br&gt;1. пакетный метод API системы-владельца;&lt;br&gt;2. выгрузка, которую владелец делает сам и кладёт в согласованное место;&lt;br&gt;3. чтение реплики, предоставленной владельцем явно и под его ответственность.&lt;br&gt;&lt;br&gt;До выбора одного из них ADR-003 остаётся в статусе Proposed — это единственное, что мешает Accepted." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FBE6E1;strokeColor=#B33D26;fontSize=11;fontColor=#5A1A0D;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="1090" y="790" width="360" height="270" as="geometry"/></mxCell><mxCell id="n_biometry" value="&lt;b&gt;〔152-ФЗ, ст. 11〕 Расшифровки колл-центра — биометрия&lt;/b&gt;&lt;br&gt;Голос квалифицируется как биометрические персональные данные. Для их обработки нужно &lt;b&gt;письменное согласие субъекта&lt;/b&gt;, а не просто правовое основание.&lt;br&gt;&lt;br&gt;PII Filter закрывает обезличивание, но &lt;b&gt;не заменяет согласие&lt;/b&gt;: если согласия нет, источник 10 нельзя брать в корпус вообще, независимо от качества анонимизации." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FBF0DC;strokeColor=#A66A12;fontSize=11;fontColor=#4A2F05;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="1490" y="790" width="330" height="200" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram><diagram id="data-architecture-online-inference" name="Архитектура данных — Онлайн-инференс: источники и сбор">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Архитектура данных для онлайн-инференса — источники, сбор и путь до модели" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;font color=&quot;#7A3EA1&quot;&gt;&lt;b&gt;〈ONLINE〉&lt;/b&gt;&lt;/font&gt; — обращение в момент запроса, задержка критична. Хранилища ниже построены заранее пакетно (BATCH) — см. схему обучения; здесь их только читают" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1180" height="24" as="geometry" />
        </mxCell>

        <mxCell id="subscriber" value="&lt;b&gt;Абонент&lt;/b&gt;&lt;br&gt;[Персона]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="widget" value="&lt;b&gt;AI-виджет&lt;/b&gt;&lt;br&gt;[Контейнер]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="110" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;[Контейнер · &lt;font color=&quot;#7A3EA1&quot;&gt;〈ONLINE〉&lt;/font&gt;]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Собирает данные из четырёх мест ниже, чтобы сформировать ответ на один вопрос абонента&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="100" width="780" height="90" as="geometry" />
        </mxCell>

        <!-- Lane 1: Vector DB -->
        <mxCell id="mech1" value="&lt;b&gt;Эмбеддинг запроса&lt;/b&gt;&lt;br&gt;[GPU-сервис · &lt;font color=&quot;#7A3EA1&quot;&gt;〈ONLINE〉&lt;/font&gt;, один запрос]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Embedding Inference (модель BGE-M3) превращает текст вопроса в вектор, затем — семантический поиск&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="src1" value="&lt;b&gt;Vector DB — Qdrant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Построен заранее пакетной индексацией (BATCH, см. схему обучения); здесь — только чтение (ONLINE): база знаний — инструкции, реестр договоров, публичный сайт&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="260" height="150" as="geometry" />
        </mxCell>

        <!-- Lane 2: Кэш профиля -->
        <mxCell id="mech2" value="&lt;b&gt;Прямое чтение&lt;/b&gt;&lt;br&gt;[&lt;font color=&quot;#7A3EA1&quot;&gt;〈ONLINE〉&lt;/font&gt;, O(1) из Redis]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Redis + Postgres MV — уже посчитанный агрегат, без обращения к первичным системам&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="270" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="src2" value="&lt;b&gt;Кэш профиля абонента&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Построен заранее пакетно (BATCH, K8s CronJob, см. схему обучения) из Биллинга и Диспетчерской — не формальный Feature Store.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Против Training-Serving Skew:&lt;/b&gt; это та же таблица, что читает офлайн-оценка при обучении — единое определение признака для обеих сторон&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D79B00;strokeColor=#B57E00;fontColor=#FFFFFF;fontSize=12;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="340" y="440" width="260" height="180" as="geometry" />
        </mxCell>

        <!-- Lane 3: Биллинг + Диспетчерская -->
        <mxCell id="mech3" value="&lt;b&gt;Внешние API систем&lt;/b&gt;&lt;br&gt;[&lt;font color=&quot;#7A3EA1&quot;&gt;〈ONLINE〉&lt;/font&gt;, интерфейс системы-владельца]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;[ИСПРАВЛЕНО v4.5]&lt;/b&gt; XML-RPC API Биллинга и REST API Диспетчерской — используются, только когда кэш может быть устаревшим: обходят BATCH-задержку кэша ради свежести. Прямого SQL в чужие БД нет (ADR-003)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D79B00;strokeColor=#B57E00;fontColor=#FFFFFF;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="270" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="src3" value="&lt;b&gt;Биллинг + Диспетчерская&lt;/b&gt;&lt;br&gt;[Внешние системы]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Задолженность, показания, статус аварийной заявки — в реальном времени, без промежуточного хранилища&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="440" width="260" height="150" as="geometry" />
        </mxCell>

        <!-- Lane 4: Платформа ЛК -->
        <mxCell id="mech4" value="&lt;b&gt;SSO-запрос&lt;/b&gt;&lt;br&gt;[&lt;font color=&quot;#7A3EA1&quot;&gt;〈ONLINE〉&lt;/font&gt;]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Существующая интеграция с личным кабинетом — выполняется один раз при открытии диалога&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="270" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="src4" value="&lt;b&gt;Платформа ЛК&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Профиль, сессия, телефон и email абонента&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="440" width="260" height="150" as="geometry" />
        </mxCell>

        <mxCell id="generation" value="&lt;b&gt;Генерация ответа — LLM&lt;/b&gt;&lt;br&gt;[LLM Gateway → LLM Provider]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Собранные данные (найденные документы + профиль + при необходимости свежие данные Биллинга + личность абонента) уходят в промпт модели после PII-фильтра.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;→ здесь путь данных от источника завершается: модель формирует ответ на их основе&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="440" y="640" width="780" height="130" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="ed1" value="вопрос" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="subscriber" target="widget">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;" edge="1" parent="1" source="widget" target="backend">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="ed3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;" edge="1" parent="1" source="backend" target="mech1">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;" edge="1" parent="1" source="mech1" target="src1">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="ed5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;" edge="1" parent="1" source="backend" target="mech2">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;" edge="1" parent="1" source="mech2" target="src2">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="ed7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;" edge="1" parent="1" source="backend" target="mech3">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;" edge="1" parent="1" source="mech3" target="src3">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="ed9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;" edge="1" parent="1" source="backend" target="mech4">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;" edge="1" parent="1" source="mech4" target="src4">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="ed11" value="весь собранный контекст" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="generation">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1310" y="145" /><mxPoint x="1310" y="705" /></Array>
          </mxGeometry></mxCell>
        <mxCell id="ed12" value="потоковый ответ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;dashed=1;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="generation" target="widget">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="130" y="705" /></Array>
          </mxGeometry></mxCell>

      </root>
    </mxGraphModel>
  </diagram><diagram id="dfd-write-stage2" name="Этап 2 — потоки записи"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" value="&lt;b&gt;Потоки данных — Этап 2: запись наружу&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1500" height="34" as="geometry"/></mxCell><mxCell id="sub" value="&lt;font style=&quot;font-size:12px;color:#4D4D4D;&quot;&gt;Третья дорожка потоков данных: куда уходят данные, порождённые системой. Обучение и инференс — страницы 1 и 2. Все пути записи проходят через подтверждение абонента (правило 4.7) и идут только через API систем-владельцев (ADR-003).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4D4D4D;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1500" height="34" as="geometry"/></mxCell><mxCell id="band1" value="1. ПОРОЖДЕНИЕ И ПОДТВЕРЖДЕНИЕ — данные ещё внутри периметра" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B0BEC5;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#546E7A;" parent="1" vertex="1"><mxGeometry x="60" y="120" width="1180" height="300" as="geometry"/></mxCell><mxCell id="band2" value="2. ЗАПИСЬ ВО ВНЕШНИЕ СИСТЕМЫ — только через их API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B0BEC5;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#546E7A;" parent="1" vertex="1"><mxGeometry x="60" y="450" width="1180" height="320" as="geometry"/></mxCell><mxCell id="band3" value="3. СЛЕД ВНУТРИ — аудит и телеметрия остаются у нас" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B0BEC5;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#546E7A;" parent="1" vertex="1"><mxGeometry x="60" y="800" width="1180" height="210" as="geometry"/></mxCell><mxCell id="sub_p" value="&lt;b&gt;Абонент&lt;/b&gt;&lt;br&gt;[Персона]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Подтверждает или отклоняет операцию&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="90" y="175" width="210" height="100" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;Agent Orchestrator&lt;/b&gt;&lt;br&gt;[Контейнер, Этап 2]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Слоты, черновик, FSM обращения&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="350" y="165" width="250" height="120" as="geometry"/></mxCell><mxCell id="dval" value="&lt;b&gt;Draft Validator&lt;/b&gt;&lt;br&gt;[компонент оркестратора]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Полнота обязательных слотов и готовность черновика — до показа абоненту&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="650" y="160" width="250" height="130" as="geometry"/></mxCell><mxCell id="hitl" value="&lt;b&gt;HITL Gate&lt;/b&gt;&lt;br&gt;[правило 4.7]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Без подтверждения ни один write не выполняется. Проверка привязки subscriber_id к сессии (Spoofing / IDOR)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#3B0D0A;" parent="1" vertex="1"><mxGeometry x="950" y="155" width="260" height="145" as="geometry"/></mxCell><mxCell id="docgen" value="&lt;b&gt;Document Generator&lt;/b&gt;&lt;br&gt;[Контейнер, Этап 2]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Шаблон + слоты → PDF/HTML&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="650" y="315" width="250" height="90" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;S3 / MinIO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Готовые документы, ссылка с ограниченным сроком жизни&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;" parent="1" vertex="1"><mxGeometry x="350" y="310" width="250" height="100" as="geometry"/></mxCell><mxCell id="w1" value="Ответы на вопросы,&lt;br&gt;значения слотов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" parent="1" source="sub_p" target="orch" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w2" value="Собранный черновик" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" parent="1" source="orch" target="dval" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w3" value="Черновик полон" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" parent="1" source="dval" target="hitl" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w4" value="Рендер документа" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;entryX=0.2;entryY=0;" parent="1" source="orch" target="docgen" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w5" value="Готовый файл" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" parent="1" source="docgen" target="s3" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w6" value="Ссылка на документ&lt;br&gt;(вложение в диалоге)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" parent="1" source="s3" target="sub_p" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="195" y="360"/></Array></mxGeometry></mxCell><mxCell id="w7" value="Показ черновика&lt;br&gt;на подтверждение" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" parent="1" source="hitl" target="sub_p" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="140"/><mxPoint x="195" y="140"/></Array></mxGeometry></mxCell><mxCell id="badapt" value="&lt;b&gt;Billing Adapter&lt;/b&gt;&lt;br&gt;[Контейнер, Этап 2]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Idempotency-Key; собственного SQL-клиента нет&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="350" y="500" width="250" height="120" as="geometry"/></mxCell><mxCell id="inqsvc" value="&lt;b&gt;Сервис работы с обращениями&lt;/b&gt;&lt;br&gt;[Контейнер, Этап 2]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Route Selector: emergency → Диспетчерская, остальные 16 кодов таксономии (реальный справочник, ADR-011) → микросервис обращений&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="650" y="495" width="260" height="140" as="geometry"/></mxCell><mxCell id="billing" value="&lt;b&gt;Биллинг&lt;/b&gt;&lt;br&gt;[Внешняя legacy-система]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Только внешний XML-RPC API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="350" y="660" width="250" height="90" as="geometry"/></mxCell><mxCell id="inqms" value="&lt;b&gt;Микросервис обращений&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Отсюда обращения читают подрядчики и пайплайн дообучения&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="650" y="655" width="260" height="100" as="geometry"/></mxCell><mxCell id="disp" value="&lt;b&gt;Диспетчерская система&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Аварийные заявки, REST API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="960" y="660" width="250" height="90" as="geometry"/></mxCell><mxCell id="w8" value="Подтверждено → запись" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;entryX=0.6;entryY=0;" parent="1" source="hitl" target="badapt" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="989" y="470"/></Array></mxGeometry></mxCell><mxCell id="w9" value="Подтверждено → регистрация" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.45;exitY=1;entryX=0.7;entryY=0;" parent="1" source="hitl" target="inqsvc" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1067" y="440"/></Array></mxGeometry></mxCell><mxCell id="w10" value="Write + Idempotency-Key&lt;br&gt;[XML-RPC API Биллинга]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="badapt" target="billing" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w11" value="Создать обращение&lt;br&gt;[API микросервиса]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;entryX=0.5;entryY=0;" parent="1" source="inqsvc" target="inqms" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w12" value="Аварийная заявка&lt;br&gt;[REST API]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;entryX=0.2;entryY=0;" parent="1" source="inqsvc" target="disp" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="585"/></Array></mxGeometry></mxCell><mxCell id="audit" value="&lt;b&gt;Audit Writer&lt;/b&gt;&lt;br&gt;[компонент оркестратора]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Кто, что, когда, Idempotency-Key. Отказ абонента пишется тоже — с пометкой, что write не выполнялся&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="350" y="840" width="260" height="130" as="geometry"/></mxCell><mxCell id="sess" value="&lt;b&gt;Session State Store&lt;/b&gt;&lt;br&gt;[Redis / PostgreSQL]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Аудит-лог операций, состояние FSM, слоты&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;" parent="1" vertex="1"><mxGeometry x="660" y="845" width="250" height="115" as="geometry"/></mxCell><mxCell id="ch" value="&lt;b&gt;ClickHouse&lt;/b&gt;&lt;br&gt;[Хранилище]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Токены, стоимость, quality_report Guardrails&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;" parent="1" vertex="1"><mxGeometry x="960" y="845" width="250" height="115" as="geometry"/></mxCell><mxCell id="w13" value="Результат операции" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;entryX=0.15;entryY=0;" parent="1" source="badapt" target="audit" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="387" y="800"/></Array></mxGeometry></mxCell><mxCell id="w14" value="ID заявки, подразделение, статус" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;entryX=0.75;entryY=0;" parent="1" source="inqsvc" target="audit" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="676" y="790"/><mxPoint x="545" y="790"/></Array></mxGeometry></mxCell><mxCell id="w15" value="Аудит-лог&lt;br&gt;[Redis / SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" parent="1" source="audit" target="sess" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w16" value="Телеметрия использования&lt;br&gt;[async batch]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="sess" target="ch" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="935" y="902"/></Array></mxGeometry></mxCell><mxCell id="n_hitl" value="Правило 4.7. Ни одна стрелка дорожки 2 не может стартовать без прохождения HITL Gate. Отказ абонента обрывает поток и пишется в аудит." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF7DC;strokeColor=#C7B26B;fontSize=11;fontColor=#3E3410;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="1270" y="165" width="250" height="125" as="geometry"/></mxCell><mxCell id="n_adr3" value="ADR-003. Все три внешние системы получают данные только через свои API. Прямой записи в чужие БД нет ни на одном пути этой схемы." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF7DC;strokeColor=#C7B26B;fontSize=11;fontColor=#3E3410;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="1270" y="490" width="250" height="115" as="geometry"/></mxCell><mxCell id="n_stage" value="Этап 2. Схема проектная: на MVP эти контейнеры не разворачиваются (stage-gating, раздел 19, п. 9)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF7DC;strokeColor=#C7B26B;fontSize=11;fontColor=#3E3410;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="1270" y="840" width="250" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>