"e54" value="41. Отмена операции" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#33454F;strokeWidth=1.5;verticalAlign=bottom;fontSize=11;fontColor=#22313A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="2830" as="sourcePoint"/><mxPoint x="770" y="2830" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e55" value="42. Отмена" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#33454F;strokeWidth=1.5;verticalAlign=bottom;fontSize=11;fontColor=#22313A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="2876" as="sourcePoint"/><mxPoint x="1070" y="2876" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e56" value="43. Аудит-лог отказа (write не выполнялся)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#33454F;strokeWidth=1.5;verticalAlign=bottom;fontSize=11;fontColor=#22313A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="2922" as="sourcePoint"/><mxPoint x="1370" y="2922" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n57" value="FSM: возврат в FILLING или DRAFT_READY, данные слотов сохранены" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF7DC;strokeColor=#C7B26B;fontSize=11;fontColor=#3E3410;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="995" y="2956" width="450" height="34" as="geometry"/></mxCell><mxCell id="e58" value="44. Черновик отменён" style="endArrow=open;endFill=0;endSize=9;dashed=1;html=1;rounded=0;strokeColor=#5C6E79;strokeWidth=1.5;verticalAlign=bottom;fontSize=11;fontColor=#22313A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="3020" as="sourcePoint"/><mxPoint x="770" y="3020" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e59" value="45. Возврат к редактированию" style="endArrow=open;endFill=0;endSize=9;dashed=1;html=1;rounded=0;strokeColor=#5C6E79;strokeWidth=1.5;verticalAlign=bottom;fontSize=11;fontColor=#22313A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="3066" as="sourcePoint"/><mxPoint x="470" y="3066" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e60" value="46. Можно исправить и подтвердить заново" style="endArrow=open;endFill=0;endSize=9;dashed=1;html=1;rounded=0;strokeColor=#5C6E79;strokeWidth=1.5;verticalAlign=bottom;fontSize=11;fontColor=#22313A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="3112" as="sourcePoint"/><mxPoint x="170" y="3112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_17a" value="17a. Draft Validator: полнота обязательных слотов (full_name, account_number, reason)&lt;br&gt;и готовность черновика к подтверждению" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#33454F;strokeWidth=1.5;verticalAlign=bottom;fontSize=11;fontColor=#22313A;labelBackgroundColor=#FFFFFF;align=left;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="1258" as="sourcePoint"/><mxPoint x="1070" y="1310" as="targetPoint"/><Array as="points"><mxPoint x="1190" y="1258"/><mxPoint x="1190" y="1310"/></Array></mxGeometry></mxCell><mxCell id="n_draftval" value="Draft Validator — НЕ Guardrails.&lt;br&gt;Guardrails в LLM Gateway проверяют ответ&lt;br&gt;модели (ПДн, токсичность, groundedness).&lt;br&gt;Здесь — готовность черновика к HITL.&lt;br&gt;Решение зафиксировано в C3 оркестратора." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF7DC;strokeColor=#C7B26B;fontSize=11;fontColor=#3E3410;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1290" y="1240" width="250" height="88" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>