<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.0.3 Chrome/140.0.7339.249 Electron/38.7.0 Safari/537.36" version="29.0.3"><diagram id="c4l3gw2" name="LLM Gateway v2"><mxGraphModel dx="1028" dy="611" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1650" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;C4 Level 3 — Компоненты: LLM Gateway&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#16324F;" parent="1" vertex="1"><mxGeometry x="100" y="20" width="1600" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Security Layer внутри контейнера: оба потребителя проходят один путь Quota → PII Sanitizer → LiteLLM → Guardrails (правило 4.2); на прототипе к шлюзу ходит только Backend." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#5A6B7B;" parent="1" vertex="1"><mxGeometry x="100" y="62" width="2100" height="30" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b style=&quot;font-size:13px&quot;&gt;Agent Orchestrator&lt;/b&gt;&lt;br&gt;[Контейнер: Python, Этап 2]&lt;br&gt;Форма (Form Agent) — единственная LLM-роль оркестратора; Этап 2, не реализована. На прототипе оркестратор к шлюзу не обращается (раздел 80)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D6E6F5;strokeColor=#7EA6E0;dashed=1;fontColor=#16324F;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="80" y="420" width="340" height="180" as="geometry"/></mxCell><mxCell id="note_orch" value="&lt;b&gt;Целевое:&lt;/b&gt; оба потребителя проходят один путь Quota → PII Sanitizer → LiteLLM → Guardrails, обхода Security Layer для Этапа 2 нет (правило 4.2). На прототипе к шлюзу ходит только Backend." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=#D9A400;fontColor=#7A5C00;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="80" y="610" width="340" height="110" as="geometry"/></mxCell><mxCell id="backend" value="&lt;b style=&quot;font-size:13px&quot;&gt;API Gateway / Backend Service&lt;/b&gt;&lt;br&gt;[Контейнер: Go / Python FastAPI]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="80" y="760" width="340" height="180" as="geometry"/></mxCell><mxCell id="provider" value="&lt;b style=&quot;font-size:13px&quot;&gt;LLM Provider&lt;/b&gt;&lt;br&gt;[External: управляемый API на территории РФ — GigaChat / YandexGPT; self-hosted по критериям ADR-002]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8A9BA8;strokeColor=#5F7182;fontColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2380" y="620" width="340" height="180" as="geometry"/></mxCell><mxCell id="boundary" value="LLM Gateway [Контейнер: Python / LiteLLM]" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#5B8DB8;dashed=1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;fontSize=15;fontStyle=1;fontColor=#16324F;" parent="1" vertex="1"><mxGeometry x="480" y="240" width="1820" height="1160" as="geometry"/></mxCell><mxCell id="guardrails" value="&lt;b style=&quot;font-size:13px&quot;&gt;Guardrails&lt;/b&gt;  [кастомные валидаторы + LLM-judge async]&lt;br&gt;&lt;b&gt;Sync (&amp;lt;50 мс):&lt;/b&gt; ПДн в ответе (spaCy/Presidio), токсичность, policy — regex, обрыв потока.&lt;br&gt;&lt;b&gt;Async:&lt;/b&gt; судья по ADR-007 (app/quality/live.py) — фоновой задачей после стрима (правило 4.3), строка в quality_assessments. Не гейт.&lt;br&gt;На прототипе судья слабый — provisional (пункт 82). check_groundedness (доля слов) — запасной путь. Ночной прогон — тоже." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#16324F;fontSize=11;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1"><mxGeometry x="1520" y="300" width="440" height="260" as="geometry"/></mxCell><mxCell id="quota" value="&lt;b style=&quot;font-size:13px&quot;&gt;Quota Manager&lt;/b&gt;  [slowapi + Redis]&lt;br&gt;Лимиты RPS и квоты — на абонента и сессию, + глобальный лимит сервиса.&lt;br&gt;&lt;b&gt;Превышение → 429 + Retry-After&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#D9A400;fontColor=#16324F;fontSize=11;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1"><mxGeometry x="560" y="680" width="400" height="260" as="geometry"/></mxCell><mxCell id="sanitizer" value="&lt;b style=&quot;font-size:13px&quot;&gt;PII Sanitizer&lt;/b&gt;  [Presidio + кастомные распознаватели]&lt;br&gt;Скрывает ПДн (ФИО, СНИЛС, ИНН, телефон, email, л/с) &lt;b&gt;ДО&lt;/b&gt; отправки в LLM Provider" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#16324F;fontSize=11;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1"><mxGeometry x="1040" y="680" width="400" height="260" as="geometry"/></mxCell><mxCell id="litellm" value="&lt;b style=&quot;font-size:13px&quot;&gt;LiteLLM Core&lt;/b&gt;  [Off-the-shelf: Python Proxy]&lt;br&gt;• OpenAI-совместимый API (контроллер)&lt;br&gt;• Маршрутизатор моделей + fallback&lt;br&gt;• Retry / Circuit Breaker / Timeout&lt;br&gt;• Адаптеры LLM-провайдеров (100+)&lt;br&gt;• SSE-стриминг токенов" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D6E6F5;strokeColor=#2F80C3;fontColor=#16324F;fontSize=11;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1"><mxGeometry x="1520" y="680" width="440" height="260" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;[Контейнер: Cache]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#E5E8EA;strokeColor=#5F7182;fontColor=#16324F;fontSize=11;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1"><mxGeometry x="620" y="1180" width="300" height="160" as="geometry"/></mxCell><mxCell id="postgres" value="&lt;b&gt;Postgres — БД telemetry&lt;/b&gt;&lt;br&gt;usage_events (помимо Billing Callback) + quality_reports (итог прогона судьи); на MVP — ClickHouse" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#D5F0E1;strokeColor=#1E8449;fontColor=#16324F;fontSize=11;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1"><mxGeometry x="1560" y="1180" width="380" height="170" as="geometry"/></mxCell><mxCell id="clickhouse" value="&lt;b&gt;ClickHouse&lt;/b&gt;&lt;br&gt;[Analytics DB — целевое, MVP]&lt;br&gt;На прототипе не развёрнут; роль играет Postgres (usage_events, quality_reports, quality_assessments)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#E5E8EA;strokeColor=#5F7182;dashed=1;fontColor=#16324F;fontSize=11;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1"><mxGeometry x="2020" y="1180" width="320" height="170" as="geometry"/></mxCell><mxCell id="note_v" value="&lt;b&gt;[v4.50]&lt;/b&gt; Бокс Billing Callback свёрнут: это две записи метрик, не компонент. Учёт сейчас: llm_gateway_tokens_total, llm_provider_used_total, гистограммы времён — в Prometheus (порт 9100, дашборд раздел 37), плюс строка на вызов в usage_events (Postgres на прототипе, ClickHouse на MVP — раздел 35.1). Стоимость в деньгах не учитывается (нет тарифов, P0 №1).   &lt;b&gt;[v4.51]&lt;/b&gt; quality_report (rel_10): на выходе шлюза — дешёвая check_groundedness (provisional); настоящую оценку даёт судья app/quality/ ночным прогоном (scripts/run_quality_eval.py) в таблицу quality_reports." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=#D9A400;fontColor=#7A5C00;fontSize=11;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1"><mxGeometry x="480" y="1430" width="1820" height="170" as="geometry"/></mxCell><mxCell id="legend" value="Легенда" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D4DE;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;fontSize=12;fontStyle=1;fontColor=#16324F;" parent="1" vertex="1"><mxGeometry x="2380" y="1430" width="340" height="170" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#D9A400;" parent="1" vertex="1"><mxGeometry x="2400" y="1462" width="26" height="14" as="geometry"/></mxCell><mxCell id="lg1t" value="Квоты / рейт-лимиты" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="2434" y="1459" width="270" height="20" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;" parent="1" vertex="1"><mxGeometry x="2400" y="1486" width="26" height="14" as="geometry"/></mxCell><mxCell id="lg2t" value="Security Layer: PII-санитайзер, Guardrails" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="2434" y="1483" width="270" height="20" as="geometry"/></mxCell><mxCell id="lg3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E6F5;strokeColor=#2F80C3;" parent="1" vertex="1"><mxGeometry x="2400" y="1510" width="26" height="14" as="geometry"/></mxCell><mxCell id="lg3t" value="Ядро прокси / целевые контейнеры Этапа 2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="2434" y="1507" width="270" height="20" as="geometry"/></mxCell><mxCell id="lg4" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=6;fillColor=#D5F0E1;strokeColor=#1E8449;" parent="1" vertex="1"><mxGeometry x="2400" y="1532" width="26" height="18" as="geometry"/></mxCell><mxCell id="lg4t" value="Хранилища телеметрии" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="2434" y="1531" width="270" height="20" as="geometry"/></mxCell><mxCell id="lg5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=#D9A400;" parent="1" vertex="1"><mxGeometry x="2400" y="1560" width="26" height="14" as="geometry"/></mxCell><mxCell id="lg5t" value="Решения / версии (заметки)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="2434" y="1557" width="270" height="20" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;3. Запрос генерации&lt;/b&gt; [Internal HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.65;" parent="1" source="backend" target="quota" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="120" as="offset"/></mxGeometry></mxCell><mxCell id="k2" value="&lt;b&gt;Промпты LLM-ролей (Этап 2)&lt;/b&gt; [Internal HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;dashed=1;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.44;entryX=0;entryY=0.25;" parent="1" source="orch" target="quota" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="20" as="offset"/><Array as="points"><mxPoint x="500" y="500"/><mxPoint x="500" y="745"/></Array></mxGeometry></mxCell><mxCell id="k3" value="&lt;b&gt;Запрос в пределах лимита&lt;/b&gt; → обезличивание" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="quota" target="sanitizer" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint y="-190" as="offset"/></mxGeometry></mxCell><mxCell id="k4" value="&lt;b&gt;Чистый промпт&lt;/b&gt; (ПДн скрыты)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="sanitizer" target="litellm" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint y="-190" as="offset"/></mxGeometry></mxCell><mxCell id="k5" value="&lt;b&gt;Ответ модели + контекст запроса&lt;/b&gt; (для проверки)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" parent="1" source="litellm" target="guardrails" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" as="offset"/></mxGeometry></mxCell><mxCell id="k6" value="&lt;b&gt;Провалидированный SSE-стрим (возврат)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" parent="1" source="guardrails" target="backend" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint y="-15" as="offset"/><Array as="points"><mxPoint x="1740" y="200"/><mxPoint x="60" y="200"/><mxPoint x="60" y="740"/><mxPoint x="250" y="740"/></Array></mxGeometry></mxCell><mxCell id="k7" value="&lt;b&gt;Генерация ответа&lt;/b&gt; [External API / SSE]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;startArrow=classic;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" parent="1" source="litellm" target="provider" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="-10" y="-71" as="offset"/><Array as="points"><mxPoint x="2340" y="771"/><mxPoint x="2340" y="710"/></Array></mxGeometry></mxCell><mxCell id="k8" value="&lt;b&gt;Счётчики квот&lt;/b&gt; [Redis protocol]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;dashed=1;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" parent="1" source="quota" target="redis" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="-60" as="offset"/><Array as="points"><mxPoint x="860" y="1120"/><mxPoint x="770" y="1120"/></Array></mxGeometry></mxCell><mxCell id="k9" value="&lt;b&gt;usage_events:&lt;/b&gt; trace_id, subscriber_id, токены, модель, latency, исход [после сборки ответа]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;dashed=1;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="litellm" target="postgres" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="-60" as="offset"/><Array as="points"><mxPoint x="1740" y="1120"/><mxPoint x="1750" y="1120"/></Array></mxGeometry></mxCell><mxCell id="k10" value="&lt;b&gt;quality_report:&lt;/b&gt; faithfulness / answer_relevancy; судья после стрима + ночной прогон → quality_assessments / quality_reports (v4.53)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;dashed=1;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" parent="1" source="guardrails" target="clickhouse" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="-10" y="-30" as="offset"/><Array as="points"><mxPoint x="2340" y="430"/><mxPoint x="2340" y="1265"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>