<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.0.3 Chrome/140.0.7339.249 Electron/38.7.0 Safari/537.36" version="29.0.3"><diagram id="c4l3doc" name="C4 Level 3 Document Generator"><mxGraphModel dx="1028" dy="611" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="C4 Level 3 — Компоненты: Document Generator" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#16324F;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="100" y="20" width="1600" height="40" as="geometry"/></mxCell><mxCell id="3" value="Этап 2. Заполнение шаблона и выдача готового документа абоненту. На прототипе путь реализован для темы template (Этап 1, без HITL). Свёрнут до двух компонентов (v4.53)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#5A6B7B;" parent="1" vertex="1"><mxGeometry x="100" y="62" width="2100" height="30" as="geometry"/></mxCell><mxCell id="4" value="Agent Orchestrator&#10;[Python]&#10;Шаг 18: заполнение и рендер по шаблону (Этап 2). На прототипе путь template ведёт Response Router" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacing=10;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="80" y="480" width="360" height="220" as="geometry"/></mxCell><mxCell id="5" value="Document Generator [Python, Этап 2 — целевое]" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#5B8DB8;dashed=1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;fontSize=15;fontStyle=1;fontColor=#16324F;" parent="1" vertex="1"><mxGeometry x="520" y="220" width="1400" height="760" as="geometry"/></mxCell><mxCell id="6" value="Template Fill&#10;[app/documents/templates.py + responder.py]&#10;Выбор образца по inquiry_type; подстановка из Биллинга по ЛС (ФИО, счёт, адрес, данные счётчика); проверка обязательных полей; недостающие ассистент спрашивает по одному (FSM, без модели).&#10;Путь Этапа 1 — HITL не применяется" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D6E6F5;strokeColor=#2F80C3;fontColor=#16324F;fontSize=11;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1"><mxGeometry x="600" y="360" width="560" height="320" as="geometry"/></mxCell><mxCell id="7" value="Artifact&#10;[app/documents/artifact.py]&#10;render_html — лист под A4 с кнопкой «Печать» (не PDF: браузер печатает сам).&#10;ArtifactStore — каталог .documents/, токен в пути вместо presigned-URL, TTL 24 ч, best-effort. Ссылка уходит в document_url" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D6E6F5;strokeColor=#2F80C3;fontColor=#16324F;fontSize=11;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1"><mxGeometry x="1240" y="360" width="600" height="320" as="geometry"/></mxCell><mxCell id="8" value="Реестр форм&#10;[файловое хранилище]&#10;Шаблоны по типу обращения (источник 8), устав, оферта, типовые формы.&#10;На прототипе — 7 образцов по ПП РФ 644/776 в app/documents/templates.py" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8A9BA8;strokeColor=#5F7182;fontColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2020" y="300" width="460" height="220" as="geometry"/></mxCell><mxCell id="9" value="Объектное хранилище&#10;[S3 / MinIO — целевое]&#10;На прототипе не развёрнут: роль играет каталог процесса .documents/" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#D5F0E1;strokeColor=#1E8449;fontColor=#16324F;fontSize=11;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1"><mxGeometry x="2020" y="620" width="460" height="180" as="geometry"/></mxCell><mxCell id="10" value="[v4.53] Свёрнуто 5 → 2. В Template Fill влиты Render API + Template Registry + Field Validator; в Artifact — Renderer + Artifact Store Client.&#10;Находка F4 (раздел 25.1) закрыта на прототипе для темы template: render_html → ArtifactStore → document_url → маршрут стенда /documents/{token} → Document Panel виджета. Не PDF и не S3 — область MVP. Адаптер Этапа 2 app/adapters/document_generator.py (запись в S3 после HITL) остаётся заглушкой." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=#D9A400;fontColor=#7A5C00;fontSize=11;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1"><mxGeometry x="520" y="1060" width="1400" height="180" as="geometry"/></mxCell><mxCell id="11" value="Легенда" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D4DE;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;fontSize=12;fontStyle=1;fontColor=#16324F;" parent="1" vertex="1"><mxGeometry x="2020" y="880" width="460" height="170" as="geometry"/></mxCell><mxCell id="12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E6F5;strokeColor=#2F80C3;" parent="1" vertex="1"><mxGeometry x="2040" y="912" width="26" height="14" as="geometry"/></mxCell><mxCell id="13" value="Компоненты генератора документов" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="2074" y="909" width="380" height="20" as="geometry"/></mxCell><mxCell id="14" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;" parent="1" vertex="1"><mxGeometry x="2040" y="938" width="26" height="14" as="geometry"/></mxCell><mxCell id="15" value="Контейнеры-потребители" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="2074" y="935" width="380" height="20" as="geometry"/></mxCell><mxCell id="16" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8A9BA8;strokeColor=#5F7182;" parent="1" vertex="1"><mxGeometry x="2040" y="964" width="26" height="14" as="geometry"/></mxCell><mxCell id="17" value="Внешнее файловое хранилище форм" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="2074" y="961" width="380" height="20" as="geometry"/></mxCell><mxCell id="18" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=6;fillColor=#D5F0E1;strokeColor=#1E8449;" parent="1" vertex="1"><mxGeometry x="2040" y="986" width="26" height="18" as="geometry"/></mxCell><mxCell id="19" value="Объектное хранилище артефактов" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="2074" y="985" width="380" height="20" as="geometry"/></mxCell><mxCell id="20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=#D9A400;" parent="1" vertex="1"><mxGeometry x="2040" y="1014" width="26" height="14" as="geometry"/></mxCell><mxCell id="21" value="Решения / версии (заметки)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="2074" y="1011" width="380" height="20" as="geometry"/></mxCell><mxCell id="22" value="18. Заполнение и рендер (Этап 2) [Internal HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=1;" parent="1" source="4" target="6" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="23" value="19–20. Готовый документ: файл или ссылка [Internal HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;dashed=1;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=1;" parent="1" source="7" target="4" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1400" y="760"/><mxPoint x="560" y="760"/><mxPoint x="560" y="590"/></Array></mxGeometry></mxCell><mxCell id="24" value="Готовый текст бланка [in-process]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=1;" parent="1" source="6" target="7" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="25" value="Загрузка шаблона по типу [чтение]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=1;" parent="1" source="7" target="8" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1960" y="440"/><mxPoint x="1960" y="410"/></Array></mxGeometry></mxCell><mxCell id="26" value="Сохранить + отдать ссылку [на прототипе — запись в .documents/]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.6;fontColor=#16324F;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=1;" parent="1" source="7" target="9" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1960" y="600"/><mxPoint x="1960" y="710"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>