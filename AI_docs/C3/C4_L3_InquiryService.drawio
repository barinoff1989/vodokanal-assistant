<mxfile host="app.diagrams.net" version="29.0.3"><diagram id="C4 L3 — Сервис работы с обращениями" name="C4 L3 — Сервис работы с обращениями"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" value="C4 Level 3 — Компоненты: Сервис работы с обращениями" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A1A1A;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1900" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Этап 2. Регистрация обращения абонента и маршрутизация: обычные обращения — в микросервис обращений, аварийные — в Диспетчерскую систему. Только после подтверждения (правило 4.7)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4D4D4D;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1900" height="40" as="geometry"/></mxCell><mxCell id="bnd" value="Сервис работы с обращениями&amp;nbsp; [Контейнер: Go/Python, Этап 2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#4D4D4D;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#4D4D4D;" parent="1" vertex="1"><mxGeometry x="380" y="150" width="1130" height="760" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;Agent Orchestrator&lt;/b&gt;&lt;br&gt;[Контейнер: Python]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Шаги 30 и 33: регистрация обращения, передача аварийной заявки&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="60" y="300" width="260" height="150" as="geometry"/></mxCell><mxCell id="inq" value="&lt;b&gt;Микросервис обращений&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Единая точка регистрации обращений. Из него читают подрядчики и пайплайн дообучения модели (источник 3, раздел 29)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="1590" y="280" width="320" height="170" as="geometry"/></mxCell><mxCell id="disp" value="&lt;b&gt;Диспетчерская система&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Аварийные заявки, near real-time (источник 7, раздел 29)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="1590" y="520" width="320" height="130" as="geometry"/></mxCell><mxCell id="sess" value="&lt;b&gt;Session State Store&lt;/b&gt;&lt;br&gt;[Redis / PostgreSQL]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Аудит-лог операций&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1590" y="720" width="320" height="110" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Registration API&lt;/b&gt;&lt;br&gt;[точка входа]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Принимает обращение от оркестратора, возвращает ID заявки, подразделение и статус (шаг 35)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="430" y="230" width="300" height="160" as="geometry"/></mxCell><mxCell id="guard" value="&lt;b&gt;HITL Guard&lt;/b&gt;&lt;br&gt;[правило 4.7]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Отклоняет вызов без подтверждения абонента. Проверяет привязку subscriber_id к сессии (шаг 25, риски Spoofing / IDOR, раздел 13)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="800" y="230" width="300" height="170" as="geometry"/></mxCell><mxCell id="idem" value="&lt;b&gt;Idempotency Store&lt;/b&gt;&lt;br&gt;[Redis / PostgreSQL]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Idempotency-Key заявки: повторная отправка не создаёт вторую заявку&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;" parent="1" vertex="1"><mxGeometry x="430" y="470" width="300" height="150" as="geometry"/></mxCell><mxCell id="router" value="&lt;b&gt;Route Selector&lt;/b&gt;&lt;br&gt;[правила по inquiry_type]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;emergency → Диспетчерская система; остальные 9 кодов таксономии (раздел 9.3) → микросервис обращений&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="800" y="470" width="300" height="170" as="geometry"/></mxCell><mxCell id="inqclient" value="&lt;b&gt;Inquiry API Client&lt;/b&gt;&lt;br&gt;[клиент API обращений]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Создание обращения через API микросервиса (шаг 31). Прямого доступа в БД обращений нет&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="1160" y="280" width="300" height="170" as="geometry"/></mxCell><mxCell id="dispclient" value="&lt;b&gt;Dispatch Client&lt;/b&gt;&lt;br&gt;[REST-клиент]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Передача аварийной заявки (шаг 33)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="1160" y="500" width="300" height="130" as="geometry"/></mxCell><mxCell id="status" value="&lt;b&gt;Status Tracker&lt;/b&gt;&lt;br&gt;[статусы заявок]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ID обращения, подразделение, статус (шаги 32, 34). Опрос статуса по заявке&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="430" y="690" width="300" height="160" as="geometry"/></mxCell><mxCell id="audit" value="&lt;b&gt;Audit Emitter&lt;/b&gt;&lt;br&gt;[запись в Session State]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Кто, что, когда, Idempotency-Key (шаг 36)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="800" y="690" width="300" height="140" as="geometry"/></mxCell><mxCell id="i1" value="30. Регистрация обращения&lt;br&gt;[Internal HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0;entryY=0.3;" parent="1" source="orch" target="api" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i2" value="35. ID заявки и статус" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" parent="1" source="api" target="orch" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i3" value="Проверка гейта" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" parent="1" source="api" target="guard" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i4" value="Idempotency-Key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="api" target="idem" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i5" value="Разрешено" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="guard" target="router" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i6" value="Ключ не встречался" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="idem" target="router" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i7" value="Обычное обращение" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0;entryY=0.7;" parent="1" source="router" target="inqclient" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i8" value="inquiry_type = emergency" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" parent="1" source="router" target="dispclient" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i9" value="31. Создать обращение&lt;br&gt;[API микросервиса обращений]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" parent="1" source="inqclient" target="inq" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i10" value="33. Аварийная заявка&lt;br&gt;[REST API]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="dispclient" target="disp" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i11" value="32. ID обращения, подразделение" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;entryX=0.85;entryY=0;" parent="1" source="inqclient" target="status" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1205" y="660"/><mxPoint x="685" y="660"/></Array></mxGeometry></mxCell><mxCell id="i12" value="34. ID аварийной заявки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;entryX=0.6;entryY=0;" parent="1" source="dispclient" target="status" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="680"/><mxPoint x="610" y="680"/></Array></mxGeometry></mxCell><mxCell id="i13" value="Результат" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="status" target="audit" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i14" value="36. Аудит-лог&lt;br&gt;[Redis / SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.6;" parent="1" source="audit" target="sess" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="750"/></Array></mxGeometry></mxCell><mxCell id="n_name" value="Переименован из «Application Router» (раздел 5.4) в v4.5: контейнер не столько маршрутизирует, сколько регистрирует обращение и ведёт его статус. Раздел 5.4 контекста синхронизирован." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#B85450;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="430" y="950" width="950" height="60" as="geometry"/></mxCell><mxCell id="n_api" value="Общее правило (раздел 29.5, поправка v4.5): в чужую систему обращаемся только через её API, никогда напрямую в её БД. Прямого доступа в БД обращений у этого контейнера нет." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#B85450;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="430" y="1030" width="950" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>