<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.0.3 Chrome/140.0.7339.249 Electron/38.7.0 Safari/537.36" version="29.0.3"><diagram id="c4l3etl" name="C4 Level 3 ETL Worker"><mxGraphModel dx="1028" dy="611" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;C4 Level 3 — Компонент ETL Worker&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#16324F;" parent="1" vertex="1"><mxGeometry x="100" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Пайплайн индексации RAG: опрос источников → сырые копии → чанкинг → дедупликация → офлайн-реранкинг → эмбеддинги → upsert в Qdrant. Нумерация шагов 1.1–9 сохранена; in-process связи без сети, GPU-вызовы — HTTP/gRPC." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6B7B;" parent="1" vertex="1"><mxGeometry x="100" y="58" width="1800" height="30" as="geometry"/></mxCell><mxCell id="kb" value="&lt;b&gt;База знаний (файловое хранилище)&lt;/b&gt;&lt;br&gt;[Внешняя система на L2]&lt;br&gt;Регламенты и инструкции (Word), реестр договоров (файлы по типу обращения), типовые формы / устав / оферта (Word/PDF), публичный FAQ / сайт и соцсети водоканала" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#8A9BA8;strokeColor=#5F7182;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="140" y="120" width="420" height="140" as="geometry"/></mxCell><mxCell id="boundary" value="Контейнер: ETL Worker [Python / Celery Beat + воркеры, GPU-узел]" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#5B8DB8;dashed=1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;fontSize=13;fontStyle=1;fontColor=#16324F;" parent="1" vertex="1"><mxGeometry x="100" y="340" width="1900" height="960" as="geometry"/></mxCell><mxCell id="ingest" value="&lt;b&gt;1. Ingest Pipeline&lt;/b&gt;&lt;br&gt;[Python, Celery/Dramatiq worker + Unstructured.io]&lt;br&gt;Единая фаза Ingest: триггер (Celery Beat, курсор last_modified), Document Reader (Unstructured: HTML/PDF/DOCX, очистка), Metadata Enricher (3-уровневый классификатор: regex → эмбеддинг → LLM-fallback через LLM Gateway). Выход: документы с тегами inquiry_type[], department, effective_date, source_title/url" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="160" y="420" width="420" height="230" as="geometry"/></mxCell><mxCell id="splitter" value="&lt;b&gt;2. Text Splitter (чанкинг)&lt;/b&gt;&lt;br&gt;[RecursiveCharacterTextSplitter]&lt;br&gt;Чанки ~800 токенов, overlap 10–15%, границы heading-aware (## → ### → \n\n → предложение); chunk_id = hash(doc_id + heading_path + seq)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="660" y="420" width="420" height="230" as="geometry"/></mxCell><mxCell id="dedup" value="&lt;b&gt;3. Quality &amp; Dedup Filter&lt;/b&gt;&lt;br&gt;[MinHash/SimHash]&lt;br&gt;Отсев мусора/шаблонного текста; near-duplicate кластеры (Jaccard ≥ 0.9); quality_score в payload" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1160" y="420" width="420" height="230" as="geometry"/></mxCell><mxCell id="rerankcl" value="&lt;b&gt;4. Reranker Client (offline)&lt;/b&gt;&lt;br&gt;[BGE-reranker-v2-m3, cross-encoder]&lt;br&gt;Отбор представительных чанков из дубль-кластеров; rerank_score в payload. Та же модель — online в Backend (Retrieval)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="660" y="760" width="420" height="210" as="geometry"/></mxCell><mxCell id="vectorcl" value="&lt;b&gt;6. Vector DB Client&lt;/b&gt;&lt;br&gt;[qdrant-client, gRPC]&lt;br&gt;upsert (вектор + payload), tombstones по source_id; реиндекс: новая коллекция → переключение alias (без простоя поиска)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1160" y="760" width="420" height="210" as="geometry"/></mxCell><mxCell id="embcl" value="&lt;b&gt;5. Embedding Client&lt;/b&gt;&lt;br&gt;[BGE-M3 (осн.) / GigaChat Embeddings (fallback)]&lt;br&gt;Батчи 32–64, нормализация векторов (cosine); model_version в payload, retry/backoff при отказах GPU-инференса" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="660" y="1060" width="420" height="210" as="geometry"/></mxCell><mxCell id="datalake" value="&lt;b&gt;Data Lake — Raw Zone&lt;/b&gt;&lt;br&gt;[S3 / MinIO]&lt;br&gt;Сырые копии документов «как есть» до трансформации. Паттерн ELT (раздел 30): реиндексация идёт из Data Lake, без повторного похода к источнику" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1"><mxGeometry x="160" y="760" width="380" height="180" as="geometry"/></mxCell><mxCell id="syncstate" value="&lt;b&gt;Sync State&lt;/b&gt;&lt;br&gt;[PostgreSQL / Redis]&lt;br&gt;Курсоры источников, история запусков, контрольные суммы документов" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1"><mxGeometry x="160" y="1060" width="380" height="180" as="geometry"/></mxCell><mxCell id="rerankinf" value="&lt;b&gt;Reranker Inference [GPU]&lt;/b&gt;&lt;br&gt;[Deployment-сервис: TEI self-hosted]&lt;br&gt;BGE-reranker-v2-m3 (cross-encoder). Та же модель переиспользуется online в Backend/Retrieval" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D99C00;strokeColor=#A67C00;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="2100" y="420" width="440" height="160" as="geometry"/></mxCell><mxCell id="vectordb" value="&lt;b&gt;Vector Database&lt;/b&gt;&lt;br&gt;[Qdrant, контейнер L2]&lt;br&gt;HNSW m=16 / ef=128; payload-индексы: inquiry_type, department, effective_date" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1"><mxGeometry x="2100" y="760" width="440" height="160" as="geometry"/></mxCell><mxCell id="embinf" value="&lt;b&gt;Embedding Inference [GPU]&lt;/b&gt;&lt;br&gt;[Deployment-сервис: TEI/vLLM self-hosted]&lt;br&gt;BGE-M3 (осн., 1024-d) / GigaChat Embeddings API (fallback)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D99C00;strokeColor=#A67C00;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="2100" y="1060" width="440" height="160" as="geometry"/></mxCell><mxCell id="note_f7" value="&lt;b&gt;⚠ F7 (смежный P0):&lt;/b&gt; Embedding Inference и Reranker Inference — общие для пайплайна ETL и онлайн-ретривала Backend. Изоляция GPU (приоритетные окна обслуживания) — не решена; см. решение F7 на Deployment View." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=#D9A400;fontColor=#7A5C00;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1620" y="420" width="360" height="230" as="geometry"/></mxCell><mxCell id="h1" value="1.1 опрос изменений (курсор last_modified)&lt;br&gt;[Файловый доступ — как на L2]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.33;exitY=0;entryX=0.3;entryY=1;" parent="1" source="ingest" target="kb" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="-100" as="offset"/></mxGeometry></mxCell><mxCell id="h2" value="1.3 получение контента документов&lt;br&gt;[Файловый доступ — как на L2]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.45;exitY=0;entryX=0.5;entryY=1;" parent="1" source="ingest" target="kb" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" as="offset"/></mxGeometry></mxCell><mxCell id="h3" value="1.4 сохранение сырых копий&lt;br&gt;[S3 API]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" parent="1" source="ingest" target="datalake" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="-60" as="offset"/></mxGeometry></mxCell><mxCell id="h4" value="1.5 чтение при переиндексации&lt;br&gt;(без похода к источнику) [S3 API]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.45;exitY=0;entryX=0.45;entryY=1;" parent="1" source="datalake" target="ingest" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" as="offset"/></mxGeometry></mxCell><mxCell id="h5" value="1.2 чтение/запись курсоров&lt;br&gt;[SQL/KV]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;entryX=0.75;entryY=1;" parent="1" source="ingest" target="syncstate" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="-300" as="offset"/><Array as="points"><mxPoint x="454" y="1000"/><mxPoint x="600" y="1000"/><mxPoint x="600" y="1240"/><mxPoint x="445" y="1240"/></Array></mxGeometry></mxCell><mxCell id="h6" value="2. Документы с метаданными → чанкинг&lt;br&gt;[in-process]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="ingest" target="splitter" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint y="-145" as="offset"/></mxGeometry></mxCell><mxCell id="h7" value="3. Чанки ~800 токенов, overlap 10–15%&lt;br&gt;[in-process]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="splitter" target="dedup" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint y="-145" as="offset"/></mxGeometry></mxCell><mxCell id="h8" value="4. Кандидаты после дедупликации&lt;br&gt;[in-process]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="dedup" target="rerankcl" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="-470" y="45" as="offset"/><Array as="points"><mxPoint x="1370" y="710"/><mxPoint x="870" y="710"/></Array></mxGeometry></mxCell><mxCell id="h9" value="5. Скоринг пар (чанк ↔ заголовок раздела)&lt;br&gt;[HTTP, GPU-инференс]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="rerankcl" target="rerankinf" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint y="-15" as="offset"/><Array as="points"><mxPoint x="1120" y="865"/><mxPoint x="1120" y="700"/><mxPoint x="2040" y="700"/><mxPoint x="2040" y="500"/></Array></mxGeometry></mxCell><mxCell id="h10" value="6. Репрезентативные чанки + rerank_score&lt;br&gt;[in-process]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="rerankcl" target="embcl" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="-40" as="offset"/></mxGeometry></mxCell><mxCell id="h11" value="7. Батч-эмбеддинг (32–64), BGE-M3&lt;br&gt;[HTTP/gRPC, GPU]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="embcl" target="embinf" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint y="-15" as="offset"/></mxGeometry></mxCell><mxCell id="h12" value="8. Векторы + payload (model_version, rerank_score)&lt;br&gt;[in-process]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0.5;entryY=1;" parent="1" source="embcl" target="vectorcl" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="5" as="offset"/><Array as="points"><mxPoint x="1120" y="1102"/><mxPoint x="1120" y="900"/><mxPoint x="1370" y="900"/></Array></mxGeometry></mxCell><mxCell id="h13" value="9. upsert (вектор+payload), tombstones, реиндекс&lt;br&gt;[gRPC — связь есть на L2]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="vectorcl" target="vectordb" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint y="-15" as="offset"/><Array as="points"><mxPoint x="2040" y="865"/><mxPoint x="2040" y="840"/></Array></mxGeometry></mxCell><mxCell id="note_f9" value="&lt;b&gt;⚠ F9 (открытый P1, раздел 26.5):&lt;/b&gt; кросс-энкодер обучен на паре запрос ↔ документ, а применяется для отбора представительного чанка из кластера дублей — нетиповое применение. Сравнить с quality_score / центроидным сходством без второго GPU-инференса." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=#D9A400;fontColor=#7A5C00;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1620" y="680" width="360" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>