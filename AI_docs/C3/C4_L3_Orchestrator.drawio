<mxfile host="app.diagrams.net" version="29.0.3"><diagram id="C4 L3 — Agent Orchestrator" name="C4 L3 — Agent Orchestrator"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2280" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" value="C4 Level 3 — Компоненты: Agent Orchestrator" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A1A1A;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="2200" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Этап 2. FSM жизненного цикла обращения, сбор слотов, черновик, HITL-гейт и вызов инструментов. Соответствует диаграмме последовательностей Этапа 2 (шаги 3–46)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4D4D4D;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="2200" height="40" as="geometry"/></mxCell><mxCell id="bnd" value="Agent Orchestrator&amp;nbsp; [Контейнер: Python, Этап 2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#4D4D4D;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#4D4D4D;" parent="1" vertex="1"><mxGeometry x="380" y="150" width="1480" height="1160" as="geometry"/></mxCell><mxCell id="backend" value="&lt;b&gt;API Gateway / Backend&lt;/b&gt;&lt;br&gt;[Контейнер: Go / Python FastAPI]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Делегирует сценарий (шаг 3); отдаёт ретривал для Advisor (шаг 7)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="60" y="300" width="260" height="130" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;LLM Gateway&lt;/b&gt;&lt;br&gt;[Контейнер: Python / LiteLLM]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Промпты LLM-ролей: Triage, Advisor, Form&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="1930" y="300" width="280" height="120" as="geometry"/></mxCell><mxCell id="sess" value="&lt;b&gt;Session State Store&lt;/b&gt;&lt;br&gt;[Redis / PostgreSQL]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Состояние FSM, слоты, аудит-лог&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1930" y="500" width="280" height="120" as="geometry"/></mxCell><mxCell id="docgen" value="&lt;b&gt;Document Generator&lt;/b&gt;&lt;br&gt;[Контейнер: Python]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Шаг 18–19: рендер документа&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="1930" y="700" width="280" height="110" as="geometry"/></mxCell><mxCell id="badapter" value="&lt;b&gt;Billing Adapter&lt;/b&gt;&lt;br&gt;[Контейнер: Go/Python]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Шаг 26–29: запись в Биллинг&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="1930" y="870" width="280" height="110" as="geometry"/></mxCell><mxCell id="inqsvc" value="&lt;b&gt;Сервис работы с обращениями&lt;/b&gt;&lt;br&gt;[Контейнер: Go/Python]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Шаг 30–35: регистрация, статусы&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="1930" y="1040" width="280" height="120" as="geometry"/></mxCell><mxCell id="ctl" value="&lt;b&gt;Scenario Controller&lt;/b&gt;&lt;br&gt;[Python, точка входа]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Принимает делегирование от Backend, ведёт сценарий обращения, возвращает результат (ID заявки, подразделение, статус, следующие шаги — шаг 37)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="430" y="230" width="300" height="150" as="geometry"/></mxCell><mxCell id="fsm" value="&lt;b&gt;Inquiry FSM&lt;/b&gt;&lt;br&gt;[transitions (кандидат на LangGraph StateGraph)]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;INIT → CLASSIFIED → FILLING → DRAFT_READY → AWAITING_CONFIRMATION → SUBMITTED → COMPLETED. Переходы: classify, fill, finalize_draft, request_confirm, submit, complete. Недопустимый переход отклоняется&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="430" y="430" width="300" height="200" as="geometry"/></mxCell><mxCell id="triage" value="&lt;b&gt;Triage Agent&lt;/b&gt;&lt;br&gt;[LLM-роль через Gateway]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;inquiry_type + confidence (шаги 5–6). Единая таксономия, 10 canonical-кодов (раздел 9.3). При недоступности LLM — keyword-режим&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="800" y="230" width="290" height="160" as="geometry"/></mxCell><mxCell id="advisor" value="&lt;b&gt;Advisor Agent&lt;/b&gt;&lt;br&gt;[LLM-роль через Gateway]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Консультация по найденному контексту (шаги 7–8). Ретривал не делает сам — запрашивает у Backend (правило 4.1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="800" y="430" width="290" height="150" as="geometry"/></mxCell><mxCell id="form" value="&lt;b&gt;Form Agent&lt;/b&gt;&lt;br&gt;[LLM-роль через Gateway]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Определяет недостающие слоты (шаги 9–10), формулирует вопрос абоненту&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="800" y="620" width="290" height="130" as="geometry"/></mxCell><mxCell id="slots" value="&lt;b&gt;Slot Store&lt;/b&gt;&lt;br&gt;[in-memory + Session State]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;full_name, account_number, phone, email, address, reason, extra. Обязательные: full_name, account_number, reason&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;" parent="1" vertex="1"><mxGeometry x="800" y="790" width="290" height="140" as="geometry"/></mxCell><mxCell id="draftval" value="&lt;b&gt;Draft Validator&lt;/b&gt;&lt;br&gt;[правила, без LLM]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Полнота обязательных слотов и корректность черновика ДО показа абоненту. Не путать с Guardrails в LLM Gateway: там проверяется ответ модели (ПДн, токсичность, groundedness), здесь — готовность черновика к HITL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="1170" y="430" width="300" height="200" as="geometry"/></mxCell><mxCell id="hitl" value="&lt;b&gt;HITL Gate&lt;/b&gt;&lt;br&gt;[правило 4.7]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Состояние AWAITING_CONFIRMATION. Без подтверждения абонента ни один write-инструмент не вызывается. Проверка привязки subscriber_id к сессии на каждом write-шаге (шаг 25 — защита Spoofing / IDOR)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="1170" y="680" width="300" height="200" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;Tool Router&lt;/b&gt;&lt;br&gt;[function-calling]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Вызов инструментов после HITL: Document Generator, Billing Adapter, Сервис работы с обращениями. Генерация и проброс Idempotency-Key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="1540" y="430" width="290" height="180" as="geometry"/></mxCell><mxCell id="audit" value="&lt;b&gt;Audit Writer&lt;/b&gt;&lt;br&gt;[запись в Session State]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Кто, что, когда, Idempotency-Key (шаг 36). Отказ абонента пишется тоже — с пометкой, что write не выполнялся (шаг 43)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;" parent="1" vertex="1"><mxGeometry x="1540" y="700" width="290" height="160" as="geometry"/></mxCell><mxCell id="o1" value="3. Делегирование сценария&lt;br&gt;[Internal HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" parent="1" source="backend" target="ctl" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o2" value="37. ID заявки, подразделение,&lt;br&gt;статус, следующие шаги" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" parent="1" source="ctl" target="backend" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o3" value="Создать и вести состояние (шаг 4)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="ctl" target="fsm" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o4" value="classify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.15;entryX=0;entryY=0.7;" parent="1" source="fsm" target="triage" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o5" value="консультация" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.45;entryX=0;entryY=0.4;" parent="1" source="fsm" target="advisor" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o6" value="fill — сбор слотов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;entryX=0;entryY=0.4;" parent="1" source="fsm" target="form" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o7" value="17. Сохранить слот" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="form" target="slots" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o8" value="Слоты на проверку" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0.5;entryY=1;" parent="1" source="slots" target="draftval" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1320" y="860"/></Array></mxGeometry></mxCell><mxCell id="o9" value="finalize_draft → request_confirm&lt;br&gt;(черновик полон)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="draftval" target="hitl" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o10" value="22–24. Подтверждение получено → submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0.5;entryY=1;" parent="1" source="hitl" target="tools" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="780"/></Array></mxGeometry></mxCell><mxCell id="o11" value="Результат операции" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="tools" target="audit" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o12" value="5. Классификация [Internal HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.2;" parent="1" source="triage" target="gw" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o13" value="6. Промпт роли Advisor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.6;" parent="1" source="advisor" target="gw" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1880" y="470"/><mxPoint x="1880" y="372"/></Array></mxGeometry></mxCell><mxCell id="o14" value="7. Запрос ретривала&lt;br&gt;[Internal HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" parent="1" source="advisor" target="backend" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="545"/><mxPoint x="760" y="365"/></Array></mxGeometry></mxCell><mxCell id="o15" value="9. Каких данных не хватает" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0;entryY=0.9;" parent="1" source="form" target="gw" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1900" y="652"/><mxPoint x="1900" y="408"/></Array></mxGeometry></mxCell><mxCell id="o16" value="36 / 43. Аудит-лог&lt;br&gt;[Redis / SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.7;" parent="1" source="audit" target="sess" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o17" value="Состояние FSM и слоты&lt;br&gt;[Redis / SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;entryX=0.15;entryY=1;dashed=1;" parent="1" source="fsm" target="sess" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="1270"/><mxPoint x="1972" y="1270"/></Array></mxGeometry></mxCell><mxCell id="o18" value="18. Рендер документа" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" parent="1" source="tools" target="docgen" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o19" value="26. Запись операции&lt;br&gt;(после HITL)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.55;entryX=0;entryY=0.4;" parent="1" source="tools" target="badapter" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o20" value="30 / 33. Регистрация обращения,&lt;br&gt;аварийная заявка" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;entryX=0;entryY=0.35;" parent="1" source="tools" target="inqsvc" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_guard" value="Guardrails (ПДн / токсичность / groundedness ответа модели) живут в LLM Gateway и здесь НЕ дублируются — решение зафиксировано этой диаграммой (открытый вопрос код-шага 6 Build_Plan закрыт). На уровне оркестратора остаётся Draft Validator с другой задачей: готовность черновика к подтверждению." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#B85450;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="430" y="1130" width="700" height="90" as="geometry"/></mxCell><mxCell id="n_fsm" value="Библиотека FSM: сейчас transitions. Миграция на LangGraph StateGraph — нужен ADR (раздел 26.5, п. 2), решения пока нет." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#B85450;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="1170" y="1130" width="660" height="60" as="geometry"/></mxCell><mxCell id="n_stage" value="Контейнер Этапа 2. Внедряется только после метрик Этапа 1 (stage-gating, раздел 19 п. 9). Диаграмма — проектная, не отражает работающий код." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#B85450;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="380" y="1330" width="900" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>