<mxfile host="app.diagrams.net" version="29.0.3"><diagram id="c4-l3-widget" name="C3 — AI-виджет в ЛК"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1280" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ttl" value="C4 Level 3 — Компоненты: AI-виджет в ЛК" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1700" height="32" as="geometry" /></mxCell><mxCell id="sub" value="Встраивается в существующий Личный кабинет. Отвечает за поток ответа на экран (правило 4.3), источники, suggested_actions и подтверждение операций Этапа 2 (правило 4.7)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1700" height="40" as="geometry" /></mxCell><mxCell id="boundary" value="Контейнер: AI-виджет в ЛК  [React / TypeScript / Node.js]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#4D4D4D;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="1300" height="1010" as="geometry" /></mxCell><mxCell id="user" value="&lt;b&gt;Абонент&lt;/b&gt;&lt;br&gt;[Персона]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="240" height="90" as="geometry" /></mxCell><mxCell id="lk" value="&lt;b&gt;Платформа ЛК&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;&lt;font style='font-size:11px'&gt;SSO-сессия, контекст кабинета, точка встраивания&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="300" height="110" as="geometry" /></mxCell><mxCell id="backend" value="&lt;b&gt;API Gateway / Backend&lt;/b&gt;&lt;br&gt;[Контейнер: Go / Python FastAPI]&lt;br&gt;&lt;font style='font-size:11px'&gt;POST /v1/generate, SSE-поток&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1430" y="560" width="300" height="130" as="geometry" /></mxCell><mxCell id="shell" value="&lt;b&gt;Widget Shell&lt;/b&gt;&lt;br&gt;[React-компонент, embed в ЛК]&lt;br&gt;&lt;font style='font-size:11px'&gt;Точка монтирования в существующий ЛК; способ встраивания (widget / iframe / micro-frontend) — открытый вопрос раздела 16&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="110" y="320" width="380" height="160" as="geometry" /></mxCell><mxCell id="ctx" value="&lt;b&gt;Session Context Provider&lt;/b&gt;&lt;br&gt;[React context]&lt;br&gt;&lt;font style='font-size:11px'&gt;subscriber_id и session_id из SSO-сессии ЛК; channel = lk_web | lk_mobile (раздел 9.7). Метаданные обязательны для аудита и квот (раздел 7.2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="530" y="320" width="380" height="160" as="geometry" /></mxCell><mxCell id="apic" value="&lt;b&gt;API Client&lt;/b&gt;&lt;br&gt;[fetch / EventSource]&lt;br&gt;&lt;font style='font-size:11px'&gt;POST /v1/generate {stream: true}; разбор RFC 7807; повтор по 429 с учётом Retry-After&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="950" y="320" width="350" height="160" as="geometry" /></mxCell><mxCell id="sse" value="&lt;b&gt;SSE Consumer&lt;/b&gt;&lt;br&gt;[обработчик событий]&lt;br&gt;&lt;font style='font-size:11px'&gt;token / metadata / done / error (раздел 7.3). Отрисовка по мере поступления — абонент видит, что ответ печатается (правило 4.3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="110" y="530" width="380" height="160" as="geometry" /></mxCell><mxCell id="render" value="&lt;b&gt;Message Renderer&lt;/b&gt;&lt;br&gt;[чат-лента]&lt;br&gt;&lt;font style='font-size:11px'&gt;История диалога, инкрементальная отрисовка токенов, индикатор набора&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="530" y="530" width="380" height="160" as="geometry" /></mxCell><mxCell id="sources" value="&lt;b&gt;Sources Panel&lt;/b&gt;&lt;br&gt;[источники ответа]&lt;br&gt;&lt;font style='font-size:11px'&gt;sources + confidence_score + disclaimer из metadata-события. Требование DoD раздела 18&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="950" y="530" width="350" height="160" as="geometry" /></mxCell><mxCell id="actions" value="&lt;b&gt;Suggested Actions&lt;/b&gt;&lt;br&gt;[кнопки следующих шагов]&lt;br&gt;&lt;font style='font-size:11px'&gt;Рендер suggested_actions; выбор типа обращения вручную в fallback-сценарии&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="110" y="740" width="380" height="150" as="geometry" /></mxCell><mxCell id="stage2" value="&lt;b&gt;Блок Этапа 2&lt;/b&gt;&lt;br&gt;[появляется вместе с операциями записи]&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;b&gt;Три состояния одного пути, а не три независимых компонента.&lt;/b&gt;&lt;br&gt;&lt;b&gt;Slot Form&lt;/b&gt; — ввод недостающих обязательных полей: full_name, account_number, reason.&lt;br&gt;&lt;b&gt;Confirmation Dialog&lt;/b&gt; — HITL-гейт: черновик и кнопки подтвердить / отклонить / исправить. Правило 4.7: без явного подтверждения абонента запись не выполняется.&lt;br&gt;&lt;b&gt;Document Panel&lt;/b&gt; — готовый документ ПОСЛЕ подтверждения: вложение в ленте либо ссылка с ограниченным сроком жизни (Artifact Store, C3 Document Generator).&lt;br&gt;&lt;i&gt;На Этапе 1 не существует ни один из трёх.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#5D9BD8;dashed=1;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="530" y="740" width="770" height="190" as="geometry" /></mxCell><mxCell id="errui" value="&lt;b&gt;Error &amp;amp; Fallback UI&lt;/b&gt;&lt;br&gt;[RFC 7807]&lt;br&gt;&lt;font style='font-size:11px'&gt;Понятное абоненту сообщение по type/title/detail; отдельный вид для 429 и 504&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="110" y="940" width="380" height="90" as="geometry" /></mxCell><mxCell id="store" value="&lt;b&gt;Local UI State&lt;/b&gt;&lt;br&gt;[React state]&lt;br&gt;&lt;font style='font-size:11px'&gt;Черновик сообщения, состояние диалога. ПДн абонента в браузере не кэшируются&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="530" y="940" width="380" height="90" as="geometry" /></mxCell><mxCell id="n1" value="⚠ Открытый вопрос (раздел 16): способ встраивания виджета в ЛК — widget, iframe или micro-frontend — не выбран. Влияет на изоляцию стилей, доступ к SSO-сессии и CSP." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#B85450;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="950" y="940" width="350" height="90" as="geometry" /></mxCell><mxCell id="e1" value="Диалог, подтверждение действий&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="user" target="shell"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="Монтирование в кабинет,&lt;br&gt;получение SSO-сессии" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=0;entryX=0.4;entryY=1;" edge="1" parent="1" source="shell" target="lk"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="shell" target="ctx"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="subscriber_id, session_id, channel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ctx" target="apic"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="POST /v1/generate {stream: true}&lt;br&gt;[HTTPS / JSON]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;entryX=0;entryY=0.25;" edge="1" parent="1" source="apic" target="backend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="376" /><mxPoint x="1380" y="592" /></Array></mxGeometry></mxCell><mxCell id="e6" value="SSE-поток: token / metadata / done / error&lt;br&gt;[text/event-stream]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" parent="1" source="backend" target="apic" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6b" value="Разобранные кадры события&lt;br&gt;[in-process]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;entryX=0.5;entryY=0;" parent="1" source="apic" target="sse" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="440" /><mxPoint x="900" y="500" /><mxPoint x="300" y="500" /></Array></mxGeometry></mxCell><mxCell id="e7" value="Токены по мере поступления" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="sse" target="render"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="metadata: sources, confidence_score" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0;entryY=0.75;" edge="1" parent="1" source="sse" target="sources"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="645" /></Array></mxGeometry></mxCell><mxCell id="e9" value="event: error → RFC 7807" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="sse" target="errui"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="render" target="actions"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="Слоты, черновик и готовый документ (Этап 2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.95;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="sse" target="stage2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="Выбор действия → новый запрос" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.25;entryX=0.15;entryY=1;" edge="1" parent="1" source="actions" target="apic"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="785" /></Array></mxGeometry></mxCell><mxCell id="e14" value="Подтверждение операции (HITL)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0.9;entryY=1;" edge="1" parent="1" source="stage2" target="apic"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="render" target="store"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Прототип отличается от целевой технологии&lt;/b&gt; (журнал, раздел 44.5). Заголовок «React / TypeScript / Node.js» описывает MVP. На прототипе виджет — три файла статикой (web/index.html, app.js, style.css), без сборки и без Node: React не проверил бы ничего архитектурного, зато потребовал бы второго процесса на демонстрации. Компоненты те же, реализация другая; правило 4.1 не нарушено — новых контейнеров на L2 не вводится." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7A5C00;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="110" y="1070" width="1190" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>