<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.0.3 Chrome/140.0.7339.249 Electron/38.7.0 Safari/537.36" version="29.0.3"><diagram id="c4l3" name="C4 Level 3 Widget"><mxGraphModel dx="1028" dy="611" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;C4 Level 3 — Компоненты: AI-виджет в ЛК&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#16324F;" parent="1" vertex="1"><mxGeometry x="80" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Поток ответа на экран (4.3), источники, suggested_actions, подтверждение операций Этапа 2 (4.7). Свёрнут до четырёх компонентов (v4.53)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6B7B;" parent="1" vertex="1"><mxGeometry x="80" y="60" width="1600" height="30" as="geometry"/></mxCell><mxCell id="person" value="&lt;b&gt;Абонент&lt;/b&gt;&lt;br&gt;[Персона]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#16324F;strokeColor=#0E2233;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="100" y="140" width="260" height="100" as="geometry"/></mxCell><mxCell id="lk" value="&lt;b&gt;Платформа ЛК&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;SSO-сессия, контекст кабинета, точка встраивания" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#8A9BA8;strokeColor=#5F7182;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="500" y="120" width="420" height="120" as="geometry"/></mxCell><mxCell id="apigw" value="&lt;b&gt;API Gateway / Backend&lt;/b&gt;&lt;br&gt;[Контейнер]&lt;br&gt;POST /v1/generate, SSE-поток" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="2000" y="420" width="420" height="160" as="geometry"/></mxCell><mxCell id="boundary" value="Контейнер: AI-виджет в ЛК [React / TS — целевое; на прототипе 3 файла статики]" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#5B8DB8;dashed=1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;fontSize=13;fontStyle=1;fontColor=#16324F;" parent="1" vertex="1"><mxGeometry x="80" y="340" width="1700" height="860" as="geometry"/></mxCell><mxCell id="shell" value="&lt;b&gt;Widget Shell · Session Context&lt;/b&gt;&lt;br&gt;[React-компонент, монтируется в ЛК]&lt;br&gt;Точка монтирования: subscriber_id, session_id, channel = lk_web | lk_mobile из SSO-сессии ЛК (на стенде — из справочника абонентов). Метаданные обязательны для аудита и квот (7.2). Способ встраивания — открытый вопрос раздела 16" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="120" y="400" width="700" height="190" as="geometry"/></mxCell><mxCell id="transport" value="&lt;b&gt;Transport&lt;/b&gt;&lt;br&gt;[fetch + разбор потока]&lt;br&gt;POST /v1/generate {stream:true}; кадры SSE: token / metadata / done / error (7.3); разбор RFC 7807, повтор по 429 с учётом Retry-After" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="900" y="400" width="840" height="190" as="geometry"/></mxCell><mxCell id="chatview" value="&lt;b&gt;Chat View&lt;/b&gt;&lt;br&gt;[чат-лента] Инкрементальная отрисовка токенов, индикатор набора, история диалога. Из metadata-событий: источники + confidence_score + disclaimer (DoD 18), кнопки suggested_actions, панель готового бланка (document_url, v4.53). Понятное сообщение об ошибке по type/title/detail. Черновик ввода — в памяти React; ПДн абонента в браузере не кэшируются" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="120" y="670" width="1300" height="210" as="geometry"/></mxCell><mxCell id="stage2" value="&lt;b&gt;Блок Этапа 2&lt;/b&gt;&lt;br&gt;[три состояния одного пути] &lt;b&gt;Confirmation Dialog&lt;/b&gt; — HITL-гейт (4.7): черновик + кнопки «подтвердить / отклонить». &lt;b&gt;Document Panel&lt;/b&gt; — готовый документ после подтверждения. &lt;i&gt;Прототип (стенд, web/app.js): Confirmation Dialog и Document Panel реализованы; Slot Form (недостающие поля) остаётся целевым — три обязательных поля берутся из профиля Биллинга.&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D6E6F5;strokeColor=#7EA6E0;fontColor=#16324F;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="120" y="960" width="1620" height="200" as="geometry"/></mxCell><mxCell id="note1" value="&lt;b&gt;[v4.53]&lt;/b&gt; Свёрнуто 10 → 4. В Transport влиты API Client + SSE Consumer; в Chat View — Message Renderer + Sources Panel + Suggested Actions + Error &amp; Fallback UI + Local UI State; Session Context Provider — в Widget Shell. Способ встраивания (widget / iframe / micro-frontend) — не выбран, раздел 16: влияет на изоляцию стилей, доступ к SSO и CSP." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=#D9A400;fontColor=#7A5C00;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="80" y="1240" width="1140" height="150" as="geometry"/></mxCell><mxCell id="note2" value="&lt;b&gt;Прототип отличается от целевой технологии&lt;/b&gt; (журнал 44.5). «React / TS / Node» — это MVP: на прототипе виджет — три файла статики (web/index.html, app.js, style.css), без сборки и Node. React не проверил бы ничего архитектурного, зато потребовал бы второго процесса на демонстрации; реализация проще, правило 4.1 не нарушено." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=#D9A400;fontColor=#7A5C00;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1260" y="1240" width="1160" height="150" as="geometry"/></mxCell><mxCell id="e1" value="Диалог, подтверждение действий&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" parent="1" source="person" target="shell" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="Монтирование, SSO-сессия [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=0;entryX=0.5;entryY=1;" parent="1" source="shell" target="lk" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="-10" y="-12" as="offset"/><Array as="points"><mxPoint x="400" y="270"/><mxPoint x="710" y="270"/></Array></mxGeometry></mxCell><mxCell id="e3" value="subscriber_id, session_id, channel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="shell" target="transport" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="e4" value="POST /v1/generate {stream:true}&lt;br&gt;[HTTPS / JSON]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.25;" parent="1" source="transport" target="apigw" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint y="-15" as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="SSE-поток&lt;br&gt;[text/event-stream]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.65;entryX=1;entryY=0.65;" parent="1" source="apigw" target="transport" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint y="15" as="offset"/></mxGeometry></mxCell><mxCell id="e6" value="Токены, источники, кнопки, ошибки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;entryX=0.65;entryY=0;" parent="1" source="transport" target="chatview" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="-120" as="offset"/></mxGeometry></mxCell><mxCell id="e7" value="Выбор действия → новый запрос" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=0;entryX=0.4;entryY=1;" parent="1" source="chatview" target="transport" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" as="offset"/></mxGeometry></mxCell><mxCell id="e8" value="Слоты, черновик, готовый бланк (Этап 2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;dashed=1;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;entryX=0.12;entryY=0;" parent="1" source="chatview" target="stage2" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" as="offset"/></mxGeometry></mxCell><mxCell id="e9" value="Подтверждение операции (HITL) → новый запрос" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B7B;dashed=1;strokeWidth=1.5;fontColor=#16324F;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.91;exitY=0;entryX=0.83;entryY=1;" parent="1" source="stage2" target="transport" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>