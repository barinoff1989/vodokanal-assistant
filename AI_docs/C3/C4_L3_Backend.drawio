<mxfile host="app.diagrams.net" version="29.0.3"><diagram id="c4-l3-backend" name="C3 — API Gateway / Backend"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" value="C4 Level 3 — Компоненты: API Gateway / Backend" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1700" height="32" as="geometry"/></mxCell><mxCell id="sub" value="Самый нагруженный контейнер проекта: по правилу 4.1 контейнера AI Service нет, и вся RAG-логика живёт здесь. Внешние соседи и протоколы — по C4 L2." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1700" height="40" as="geometry"/></mxCell><mxCell id="boundary" value="Контейнер: API Gateway / Backend  [Go / Python FastAPI]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#4D4D4D;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="1560" height="1010" as="geometry"/></mxCell><mxCell id="widget" value="&lt;b&gt;AI-виджет в ЛК&lt;/b&gt;&lt;br&gt;[Контейнер: React/TS]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="280" height="90" as="geometry"/></mxCell><mxCell id="lk" value="&lt;b&gt;Платформа ЛК&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;SSO, сессии, профиль&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="250" height="110" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;LLM Gateway&lt;/b&gt;&lt;br&gt;[Контейнер: Python/LiteLLM]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;PII Sanitizer, Guardrails, квоты&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1690" y="300" width="300" height="120" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;Agent Orchestrator&lt;/b&gt;&lt;br&gt;[Контейнер: Python, Этап 2]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1690" y="470" width="300" height="100" as="geometry"/></mxCell><mxCell id="sess" value="&lt;b&gt;Session State Store&lt;/b&gt;&lt;br&gt;[Redis / PostgreSQL]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1690" y="640" width="300" height="110" as="geometry"/></mxCell><mxCell id="bill" value="&lt;b&gt;Биллинг&lt;/b&gt;&lt;br&gt;[Внешняя legacy-система]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1690" y="810" width="300" height="90" as="geometry"/></mxCell><mxCell id="disp" value="&lt;b&gt;Диспетчерская система&lt;/b&gt;&lt;br&gt;[Внешняя система]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1690" y="940" width="300" height="90" as="geometry"/></mxCell><mxCell id="emb" value="&lt;b&gt;Embedding Inference&lt;/b&gt;&lt;br&gt;[TEI/vLLM, GPU]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D79B00;strokeColor=#B57E00;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="180" y="1330" width="300" height="90" as="geometry"/></mxCell><mxCell id="vdb" value="&lt;b&gt;Vector Database&lt;/b&gt;&lt;br&gt;[Qdrant]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="1330" width="280" height="90" as="geometry"/></mxCell><mxCell id="rer" value="&lt;b&gt;Reranker Inference&lt;/b&gt;&lt;br&gt;[TEI, GPU]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D79B00;strokeColor=#B57E00;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="880" y="1330" width="300" height="90" as="geometry"/></mxCell><mxCell id="ch" value="&lt;b&gt;ClickHouse&lt;/b&gt;&lt;br&gt;[Аналитическая БД]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="1330" width="280" height="90" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;HTTP API Layer&lt;/b&gt;&lt;br&gt;[FastAPI router]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;POST /v1/generate, GET /v1/healthz (правило 4.4); URI-версионирование /v1/ (4.6); RFC 7807 на всех ошибках (4.5); валидация: query ≤ 2000 символов, system обязателен&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="110" y="320" width="330" height="170" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b&gt;Auth &amp;amp; Session Middleware&lt;/b&gt;&lt;br&gt;[SSO-клиент ЛК]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Проверка сессии ЛК, извлечение subscriber_id; привязка subscriber_id к сессии на каждом запросе (риск Spoofing/IDOR, раздел 13)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="320" width="330" height="170" as="geometry"/></mxCell><mxCell id="sse" value="&lt;b&gt;SSE Streamer&lt;/b&gt;&lt;br&gt;[text/event-stream]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;События token / metadata / done / error (раздел 7.3). Проброс потока без буферизации — правило 4.3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="850" y="320" width="330" height="170" as="geometry"/></mxCell><mxCell id="metrics" value="&lt;b&gt;Metrics Emitter&lt;/b&gt;&lt;br&gt;[Prometheus client]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;assistant_ttft_seconds, latency, inquiry_type-разбивка (раздел 37)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1220" y="320" width="330" height="170" as="geometry"/></mxCell><mxCell id="taxo" value="&lt;b&gt;Taxonomy Service&lt;/b&gt;&lt;br&gt;[canonical enum]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;10 кодов inquiry_type (раздел 9.3), strip().lower(), display names. Единый справочник — правило 4.8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="110" y="530" width="330" height="160" as="geometry"/></mxCell><mxCell id="triage" value="&lt;b&gt;Triage Classifier&lt;/b&gt;&lt;br&gt;[LLM + keyword fallback]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;inquiry_type + confidence; keyword-режим при недоступности LLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="530" width="330" height="160" as="geometry"/></mxCell><mxCell id="prompt" value="&lt;b&gt;Prompt Builder&lt;/b&gt;&lt;br&gt;[шаблоны промптов]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;system + query + context + metadata по контракту раздела 7.1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="850" y="530" width="330" height="160" as="geometry"/></mxCell><mxCell id="gwclient" value="&lt;b&gt;LLM Gateway Client&lt;/b&gt;&lt;br&gt;[Internal HTTP]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;X-Internal-Token, X-Trace-Id; обработка 429 + Retry-After&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1220" y="530" width="330" height="160" as="geometry"/></mxCell><mxCell id="retr" value="&lt;b&gt;Retrieval Orchestrator&lt;/b&gt;&lt;br&gt;[ядро RAG — правило 4.1]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Эмбеддинг запроса → поиск top_k=20 с payload-фильтром inquiry_type → реранжинг top_n=3. Порог score_threshold = 0.7&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="110" y="730" width="700" height="150" as="geometry"/></mxCell><mxCell id="fallback" value="&lt;b&gt;Fallback Handler&lt;/b&gt;&lt;br&gt;[политика отказа]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Ответ без вызова LLM при пустом контексте или confidence ниже порога (раздел 8.2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="850" y="730" width="330" height="150" as="geometry"/></mxCell><mxCell id="profile" value="&lt;b&gt;Subscriber Profile Cache&lt;/b&gt;&lt;br&gt;[Postgres MV + Redis]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Агрегированный профиль абонента (источник 16): долг, поверка, зона. Роль Feature Store без платформы (раздел 32); TTL — предел отставания от Биллинга&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="730" width="330" height="150" as="geometry"/></mxCell><mxCell id="embc" value="&lt;b&gt;Embedding Client&lt;/b&gt;&lt;br&gt;[HTTP]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="110" y="920" width="220" height="80" as="geometry"/></mxCell><mxCell id="vdbc" value="&lt;b&gt;Vector Search Client&lt;/b&gt;&lt;br&gt;[qdrant-client, gRPC]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="360" y="920" width="240" height="80" as="geometry"/></mxCell><mxCell id="rerc" value="&lt;b&gt;Reranker Client&lt;/b&gt;&lt;br&gt;[HTTP, online]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="630" y="920" width="220" height="80" as="geometry"/></mxCell><mxCell id="extc" value="&lt;b&gt;External Read Clients&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Биллинг — XML-RPC API; Диспетчерская — REST API. Прямого SQL в чужие БД нет (раздел 29.5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="880" y="920" width="300" height="110" as="geometry"/></mxCell><mxCell id="sessc" value="&lt;b&gt;Session Client&lt;/b&gt;&lt;br&gt;[Redis protocol / SQL]&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Этап 1: сессия диалога, аудит, квоты&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1220" y="920" width="330" height="110" as="geometry"/></mxCell><mxCell id="n_pii" value="⚠ PII-фильтрации здесь нет и быть не должно: правило 4.2 помещает её в LLM Gateway, до обращения к LLM Provider. Backend передаёт запрос как есть." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#B85450;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="110" y="1060" width="700" height="46" as="geometry"/></mxCell><mxCell id="n_stage" value="⚠ Открытый P1 (Р4): проверка привязки subscriber_id к сессии на каждом write-шаге Этапа 2 требуется, но не реализована." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#B85450;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="850" y="1060" width="700" height="46" as="geometry"/></mxCell><mxCell id="e1" value="Запрос абонента&lt;br&gt;[HTTPS / JSON]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="widget" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="SSE-стрим до виджета&lt;br&gt;[text/event-stream]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=0;entryX=0.85;entryY=1;" edge="1" parent="1" source="sse" target="widget"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="250"/><mxPoint x="338" y="250"/></Array></mxGeometry></mxCell><mxCell id="e3" value="Проверка сессии SSO,&lt;br&gt;профиль абонента [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="auth" target="lk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="auth"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="Нормализованный запрос" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="api" target="taxo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Canonical enum" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWi