          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ekb2" edge="1" parent="1" source="kb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.35;exitY=0;entryX=0.05;entryY=1;" target="router" value="top_n=3 чанка&lt;br&gt;(пусто ⇒ ответ без модели)">
          <mxGeometry relative="1" as="geometry" />
