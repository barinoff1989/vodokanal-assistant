        <mxCell id="egw" edge="1" parent="1" source="router" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" target="gw" value="промпт с контекстом — внутрипроцессный вызов LlmGateway&lt;br&gt;(MVP: Internal HTTP, X-Internal-Token, 429 + Retry-After)">
