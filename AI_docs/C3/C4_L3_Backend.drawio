        <mxCell id="e23" edge="1" parent="1" source="sessc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="stores" value="состояние, квоты, обращения&lt;br&gt;[Redis / SQL]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e24" edge="1" parent="1" source="refdata" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="refsys" value="чтение (read) — на прототипе файлы при старте&lt;br&gt;[XML-RPC Биллинга · REST Диспетчерской]">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1620" y="1040" />
              <mxPoint x="1620" y="795" />
            </Array>
