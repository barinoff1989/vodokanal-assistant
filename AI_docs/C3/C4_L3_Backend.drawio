<mxfile host="app.diagrams.net" version="29.0.3"><diagram id="c4-l3-backend" name="C3 — API Gateway / Backend"><mxGraphModel dx="1400" dy="1080" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" value="C4 Level 3 — Компоненты: API Gateway / Backend" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1700" height="32" as="geometry"/></mxCell><mxCell id="sub" value="По правилу 4.1 контейнера AI Service нет — вся RAG-логика здесь. Свёрнуто до семи компонентов (v4.53): бокс остаётся, только если это отдельная работа с кодом на прототипе; модуль-справочник, внутрипроцессный вызов и ненаписанная заглушка — в ноты и на рёбра." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1820" height="40" as="geometry"/></mxCell><mxCell id="boundary" value="Контейнер: API Gateway / Backend  [Go / Python FastAPI]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#4D4D4D;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="1560" height="980" as="geometry"/></mxCell><mxCell id="widget" value="&lt;b&gt;AI-виджет в ЛК&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[Контейнер: React/TS]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="120" width="280" height="90" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;LLM Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[Контейнер: Python/LiteLLM] Quota → PII Sanitizer → LiteLLM → Guardrails&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;align=left;" vertex="1" parent="1"><mxGeometry x="1690" y="300" width="300" height="120" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;Agent Orchestrator&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[Контейнер: Python, Этап 2] На прототипе к шлюзу не обращается&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;align=left;dashed=1;" vertex="1" parent="1"><mxGeometry x="1690" y="450" width="300" height="90" as="geometry"/></mxCell><mxCell id="stores" value="&lt;b&gt;Session State + Quota Store&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[Redis / PostgreSQL] Состояние диалога, слоты, аудит; счётчики квот; таблица обращений&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1690" y="580" width="300" height="120" as="geometry"/></mxCell><mxCell id="refsys" value="&lt;b&gt;Биллинг · Диспетчерская · тарифы&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[Внешние системы] Биллинг — XML-RPC; Диспетчерская — REST; тарифы — файл. На прототипе всё читается из файлов при старте (раздел 75.6)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;align=left;" vertex="1" parent="1"><mxGeometry x="1690" y="730" width="300" height="130" as="geometry"/></mxCell><mxCell id="ch" value="&lt;b&gt;ClickHouse · Prometheus&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[Аналитика / метрики] Prometheus :9100; usage_events (Postgres на прототипе)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1690" y="890" width="300" height="100" as="geometry"/></mxCell><mxCell id="vdb" value="&lt;b&gt;Vector DB — Qdrant&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[Целевое] На прототипе не развёрнут: корпус в памяти (ADR-006, 75.6)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="1270" width="300" height="90" as="geometry"/></mxCell><mxCell id="infer" value="&lt;b&gt;Embedding · Reranker Inference&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[TEI/vLLM, GPU — целевое] На прототипе: e5-small на CPU в процессе, реранжинга нет (ADR-014)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D79B00;strokeColor=#B57E00;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;align=left;dashed=1;" vertex="1" parent="1"><mxGeometry x="660" y="1270" width="340" height="90" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;HTTP API Layer  ·  SSE Streamer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[FastAPI] POST /v1/generate, GET /v1/healthz (4.4); /v1/ версионирование (4.6); RFC 7807 на всех ошибках (4.5); валидация query ≤ 2000, system обязателен. Поток token/metadata/done/error без буферизации (4.3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="330" width="440" height="160" as="geometry"/></mxCell><mxCell id="triage" value="&lt;b&gt;Triage&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[правила + ключевые слова] topic (путь ответа) + inquiry_type (регистрация, метрика). Тему определяют правила: она решает, звать ли модель — узнавать это моделью значило бы платить за вызов на каждом запросе. LLM-режим Этапа 2 не написан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;align=left;" vertex="1" parent="1"><mxGeometry x="590" y="330" width="430" height="160" as="geometry"/></mxCell><mxCell id="metrics" value="&lt;b&gt;Metrics Emitter&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[prometheus_client] 14 метрик по конвенции дашборда (раздел 37) на отдельном порту 9100: TTFT, latency, токены, блокировки с разбивкой по причине, разбивка по inquiry_type&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;align=left;" vertex="1" parent="1"><mxGeometry x="1060" y="330" width="510" height="160" as="geometry"/></mxCell><mxCell id="router" value="&lt;b&gt;Response Router&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[протокол DirectResponder] По теме выбирает путь. &lt;b&gt;Пять прямых ответчиков без модели:&lt;/b&gt; outage — график отключений по адресу из Биллинга (ADR-013); water_quality — регламентная формулировка (ADR-012); tariff — таблица тарифов по дате; account — факты лицевого счёта, спор «почему столько» не берёт; template — семь образцов заявлений по ПП РФ 644/776, готовый бланк отдаётся ссылкой на лист для печати (v4.53). Предметная логика — в самих ответчиках (правило 4.1). Иначе — RAG-путь. Сборка промпта (system + query + context) — здесь и в шлюзе, отдельного Prompt Builder нет&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="530" width="1460" height="190" as="geometry"/></mxCell><mxCell id="kb" value="&lt;b&gt;Knowledge Base Search&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[ядро RAG — правило 4.1] Эмбеддинг запроса → косинус по корпусу → порог score_threshold=0.872 → top_n=3 в промпт. Пустая выдача ⇒ ответ без модели с телефоном контакт-центра (Advisor, раздел 8.2). &lt;b&gt;Целевое:&lt;/b&gt; top_k=20 + payload-фильтр inquiry_type + реранжинг top_n=3, Qdrant + Embedding/Reranker Inference. &lt;b&gt;Прототип:&lt;/b&gt; e5-small в памяти, без реранжинга (ADR-014)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="760" width="900" height="180" as="geometry"/></mxCell><mxCell id="sessc" value="&lt;b&gt;Session &amp; Quota Client&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[Redis protocol / SQL] Состояние диалога между репликами, слоты, черновик, аудит (Redis; недоступен ⇒ «сессии нет», не 503 — путь записи закрывается сам). Квоты на абонента/сессию/сервис (Redis; недоступны ⇒ 503, ADR-008). Регистрация обращения — таблица в Postgres (ADR-009)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;align=left;" vertex="1" parent="1"><mxGeometry x="1040" y="760" width="530" height="180" as="geometry"/></mxCell><mxCell id="refdata" value="&lt;b&gt;Reference Data&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;[чтение источников-слепков] Профиль абонента, счета, счётчики, начисления (Биллинг); график плановых отключений; таблица тарифов. Адрес абонента для пути outage резолвится здесь по ЛС (v4.53). &lt;b&gt;Целевое:&lt;/b&gt; XML-RPC/REST + кэш профиля Postgres MV + Redis (Feature Store без платформы, раздел 32). &lt;b&gt;Прототип:&lt;/b&gt; чтение файлов при старте, в памяти&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D9BD8;fontColor=#0B2A45;fontSize=12;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="965" width="900" height="150" as="geometry"/></mxCell><mxCell id="n_tax" value="Канонический справочник — app/taxonomy.py: две оси ADR-011 (topic — путь ответа, inquiry_type — регистрация), parse/coerce (значение вне справочника не выйдет — правило 4.8), нормализация strip().lower(). Общий импорт всех компонентов, не отдельный узел — свёрнут как Billing Callback на C4_L3_LLM.  ·  Auth &amp; Session Middleware [SSO-клиент ЛК] — целевое: на прототипе кабинета нет, subscriber_id из метаданных; написана только привязка session_id ↔ subscriber_id в Session Client (Spoofing/IDOR, раздел 13)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#B85450;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="110" y="1130" width="1460" height="55" as="geometry"/></mxCell><mxCell id="n_fold" value="[v4.53] Свёрнуто 17 → 7. В Knowledge Base Search влиты Retrieval Orchestrator + Embedding/Vector/Reranker Client + Fallback Handler; в Reference Data — External Read Clients + Subscriber Profile Cache; SSE Streamer — в HTTP API Layer. Prompt Builder и LLM Gateway Client — на рёбрах (сборка промпта; внутрипроцессный вызов). PII-фильтра здесь нет (правило 4.2, он в LLM Gateway).  ·  Открытый P1: привязка subscriber_id к сессии на каждом write-шаге Этапа 2 не реализована.  ·  Диаграмма — целевое устройство; сверка с кодом — пункт 77 TODO." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#B85450;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="110" y="1190" width="1460" height="55" as="geometry"/></mxCell><mxCell id="e1" value="Запрос абонента&lt;br&gt;[HTTPS / JSON]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="widget" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="SSE-стрим: token / metadata / done / error&lt;br&gt;[text/event-stream]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.25;entryX=0.85;entryY=1;" edge="1" parent="1" source="api" target="widget"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="300"/><mxPoint x="70" y="165"/></Array></mxGeometry></mxCell><mxCell id="e5" value="нормализованный запрос" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="triage"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="topic + inquiry_type" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="triage" target="router"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7b" value="RAG-путь (тема general): поиск контекста" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="router" target="kb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ekb2" value="top_n=3 чанка&lt;br&gt;(пусто ⇒ ответ без модели)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.35;exitY=0;entryX=0.05;entryY=1;" edge="1" parent="1" source="kb" target="router"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="egw" value="промпт с контекстом — внутрипроцессный вызов LlmGateway&lt;br&gt;(MVP: Internal HTTP, X-Internal-Token, 429 + Retry-After)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="router" target="gw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1630" y="560"/><mxPoint x="1630" y="360"/></Array></mxGeometry></mxCell><mxCell id="e11" value="поток токенов ответа" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.7;entryX=1;entryY=0.35;" edge="1" parent="1" source="gw" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1630" y="400"/><mxPoint x="600" y="470"/></Array></mxGeometry></mxCell><mxCell id="e7c" value="прямой ответ — 5 путей, без модели и без обезличивания" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.2;entryX=0.5;entryY=1;" edge="1" parent="1" source="router" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="620"/><mxPoint x="90" y="520"/></Array></mxGeometry></mxCell><mxCell id="eref" value="профиль абонента, факты счёта, график, тарифы, адрес" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="router" target="refdata"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="esess" value="сессия, черновик, аудит, квоты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="router" target="sessc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="делегирование сценария Этапа 2&lt;br&gt;[Internal HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.15;entryX=0;entryY=0.3;" edge="1" parent="1" source="api" target="orch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1640" y="355"/><mxPoint x="1640" y="475"/></Array></mxGeometry></mxCell><mxCell id="e23" value="состояние, квоты, обращения&lt;br&gt;[Redis / SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sessc" target="stores"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="чтение (read) — на прототипе файлы при старте&lt;br&gt;[XML-RPC Биллинга · REST Диспетчерской]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="refdata" target="refsys"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1620" y="1040"/><mxPoint x="1620" y="795"/></Array></mxGeometry></mxCell><mxCell id="e26" value="метрики [Prometheus :9100] + usage_events&lt;br&gt;[после сборки ответа]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="metrics" target="ch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1840" y="410"/><mxPoint x="1840" y="890"/></Array></mxGeometry></mxCell><mxCell id="evdb" value="целевое: Search(top_k=20, payload-фильтр)&lt;br&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="kb" target="vdb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="einf" value="целевое: эмбеддинг запроса, реранжинг top_n=3&lt;br&gt;[HTTP, GPU]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.6;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="kb" target="infer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>