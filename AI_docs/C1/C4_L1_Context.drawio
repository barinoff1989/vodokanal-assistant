        </mxCell>
        <mxCell id="e_annotator_sys" edge="1" parent="1" source="annotator" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;entryX=0.75;entryY=0;" target="system" value="Готовит Golden Set, валидирует ответы,&lt;br&gt;размечает спорные кейсы, оценивает качество RAG">
          <mxGeometry relative="1" x="-0.45" y="-12" as="geometry" />
