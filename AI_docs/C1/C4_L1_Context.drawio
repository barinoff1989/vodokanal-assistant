<mxfile host="Electron">
  <diagram id="c4-l1-context-v1" name="C4 L1 — Контекст">
    <mxGraphModel dx="1500" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" value="&lt;b&gt;C4 Level 1 — Контекст: «AI-помощник абонента водоканала»&lt;/b&gt;" vertex="1">
          <mxGeometry height="36" width="1500" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subscriber" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" value="&lt;b&gt;Абонент водоканала&lt;/b&gt;&lt;br&gt;[Персона]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Единственный конечный пользователь чат-интерфейса. Работает в существующем Личном кабинете&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="260" x="120" y="160" as="geometry" />
        </mxCell>
        <mxCell id="annotator" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#1F5C8B;strokeColor=#16466A;fontColor=#FFFFFF;dashed=1;dashPattern=6 4;" value="&lt;b&gt;Annotator&lt;/b&gt;&lt;br&gt;[Техническая роль — IAM]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Golden Set, валидация ответов, разметка спорных кейсов, оценка качества RAG&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="250" x="900" y="150" as="geometry" />
        </mxCell>
        <mxCell id="datascientist" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#1F5C8B;strokeColor=#16466A;fontColor=#FFFFFF;dashed=1;dashPattern=6 4;" value="&lt;b&gt;Data Scientist&lt;/b&gt;&lt;br&gt;[Техническая роль — IAM]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Анализ логов, метрики RAG (recall / precision), подготовка данных для дообучения&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="260" x="1210" y="150" as="geometry" />
        </mxCell>
        <mxCell id="system" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#1168BD;strokeColor=#0B5394;fontColor=#FFFFFF;verticalAlign=top;spacingTop=10;spacingLeft=6;spacingRight=6;align=left;" value="&lt;b&gt;AI-помощник абонента водоканала&lt;/b&gt;&lt;br&gt;[Программная система]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Встроен в Личный кабинет. агент: документы, заявки, операции в биллинге с подтверждением абонента.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="240" width="520" x="560" y="440" as="geometry" />
        </mxCell>
        <mxCell id="lk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=0;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" value="&lt;b&gt;Платформа ЛК&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SSO, сессии, профиль абонента, контекст личного кабинета. В неё встроен AI-виджет&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="270" x="50" y="470" as="geometry" />
        </mxCell>
        <mxCell id="llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" value="&lt;b&gt;LLM Provider&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;По умолчанию — управляемый API на территории РФ (GigaChat Pro / YandexGPT, 152-ФЗ, ADR-002).&lt;br&gt;Self-hosted Qwen2.5 / Llama 3.1 — по триггерам&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="340" x="1320" y="460" as="geometry" />
        </mxCell>
        <mxCell id="kb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" value="&lt;b&gt;База знаний (файловое хранилище)&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Регламенты и инструкции (Word), реестр договоров (файлы по типу обращения), типовые формы / устав / оферта (Word/PDF), публичный FAQ / сайт и соцсети водоканала&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="320" x="70" y="820" as="geometry" />
        </mxCell>
        <mxCell id="billing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" value="&lt;b&gt;Биллинг&lt;/b&gt;&lt;br&gt;[Внешняя legacy-система]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Данные абонента, показания, начисления, задолженность, данные о поверке. Доступ — только через собственный внешний XML-RPC API&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="290" x="420" y="840" as="geometry" />
        </mxCell>
        <mxCell id="inquiries" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" value="&lt;b&gt;Микросервис обращений&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Регистрация обращений абонентов (поверка, подключение, приём документов). Из него обращения читают подрядчики и пайплайн дообучения модели (источник 3, раздел 29)&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="350" x="750" y="840" as="geometry" />
        </mxCell>
        <mxCell id="dispatch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" value="&lt;b&gt;Диспетчерская система&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Аварийные заявки, near real-time (источник 7, раздел 29). Этап 1 — чтение данных по авариям для ответа. Этап 2 — передача аварийной заявки после подтверждения (HITL)&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="340" x="1160" y="840" as="geometry" />
        </mxCell>
        <mxCell id="e_sub_sys" edge="1" parent="1" source="subscriber" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.25;" target="system" value="Задаёт вопросы; получает ответ, источники&lt;br&gt;и рекомендации; подтверждает операции Этапа 2&lt;br&gt;[HTTPS, AI-виджет в ЛК]">
          <mxGeometry relative="1" x="-0.1157" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_sub_lk" edge="1" parent="1" source="subscriber" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;entryX=0.4;entryY=0;" target="lk" value="Работает в личном кабинете,&lt;br&gt;вход по SSO [HTTPS]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_sys_lk" edge="1" parent="1" source="system" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.55;entryX=1;entryY=0.5;" target="lk" value="Проверка сессии SSO,&lt;br&gt;профиль и контекст абонента [HTTPS]">
          <mxGeometry relative="1" x="0.0517" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_sys_llm" edge="1" parent="1" source="system" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.55;entryX=0;entryY=0.5;" target="llm" value="Генерация ответа по обезличенному&lt;br&gt;промпту (ПДн удалены в LLM Gateway)&lt;br&gt;[External API]">
          <mxGeometry relative="1" x="0.084" y="22" as="geometry">
            <mxPoint x="-10" y="2" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_sys_kb" edge="1" parent="1" source="system" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;entryX=0.6;entryY=0;" target="kb" value="Забор документов для индексации RAG&lt;br&gt;[Файловый доступ, только чтение]">
          <mxGeometry relative="1" x="0.4" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="800" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_sys_billing" edge="1" parent="1" source="system" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.35;exitY=1;entryX=0.55;entryY=0;" target="billing" value="Этап 1 — чтение данных абонента.&lt;br&gt;Этап 2 — запись после подтверждения (HITL)&lt;br&gt;[внешний XML-RPC API Биллинга]">
          <mxGeometry relative="1" x="-0.15" y="-8" as="geometry" />
        </mxCell>
        <mxCell id="e_sys_inquiries" edge="1" parent="1" source="system" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=1;entryX=0.4;entryY=0;" target="inquiries" value="Этап 2 — регистрация обращения абонента&lt;br&gt;после подтверждения [REST API]">
          <mxGeometry relative="1" x="-0.15" y="-8" as="geometry" />
        </mxCell>
        <mxCell id="e_sys_dispatch" edge="1" parent="1" source="system" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=1;entryX=0.35;entryY=0;" target="dispatch" value="Этап 1 — чтение данных по авариям для ответа;&lt;br&gt;Этап 2 — передача аварийной заявки после подтверждения&lt;br&gt;[REST API]">
          <mxGeometry relative="1" x="0.5" as="geometry">
