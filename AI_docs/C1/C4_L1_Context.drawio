        <mxCell id="e_ds_sys" edge="1" parent="1" source="datascientist" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.92;entryY=0;" target="system" value="Анализирует логи и метрики RAG,&lt;br&gt;готовит данные для дообучения">
