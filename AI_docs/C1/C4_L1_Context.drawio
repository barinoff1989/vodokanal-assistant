<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.0.3 Chrome/140.0.7339.249 Electron/38.7.0 Safari/537.36" version="29.0.3"><diagram id="c4l1" name="C4 Level 1"><mxGraphModel dx="1028" dy="611" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;C4 Level 1 — Контекст: «AI-помощник абонента водоканала»&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1A237E;" parent="1" vertex="1"><mxGeometry x="550" y="20" width="700" height="40" as="geometry"/></mxCell><mxCell id="person" value="&lt;b&gt;Абонент водоканала&lt;/b&gt;&lt;br&gt;[Персона]&lt;br&gt;Единственный конечный пользователь чат-интерфейса. Работает в существующем Личном кабинете" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1"><mxGeometry x="100" y="120" width="300" height="120" as="geometry"/></mxCell><mxCell id="ai" value="&lt;b&gt;AI-помощник абонента водоканала&lt;/b&gt;&lt;br&gt;[Программная система]&lt;br&gt;Встроен в Личный кабинет: агент — документы, заявки, операции в биллинге с подтверждением абонента" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;strokeWidth=3;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=middle;spacing=10;" parent="1" vertex="1"><mxGeometry x="660" y="300" width="520" height="180" as="geometry"/></mxCell><mxCell id="lk" value="&lt;b&gt;Платформа ЛК&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;SSO, сессии, профиль абонента, контекст личного кабинета. В неё встроен AI-виджет" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#78909C;strokeColor=#546E7A;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1"><mxGeometry x="100" y="380" width="300" height="140" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;LLM Provider&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;По умолчанию — управляемый API на территории РФ (GigaChat Pro / YandexGPT, 152-ФЗ, ADR-002). Self-hosted Qwen2.5 / Llama 3.1 — по триггерам" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#78909C;strokeColor=#546E7A;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1"><mxGeometry x="1400" y="315" width="320" height="150" as="geometry"/></mxCell><mxCell id="kb" value="&lt;b&gt;База знаний (файловое хранилище)&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;Регламенты и инструкции (Word), реестр договоров (файлы по типу обращения), типовые формы / устав / оферта (Word/PDF), публичный FAQ / сайт и соцсети водоканала" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#78909C;strokeColor=#546E7A;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1"><mxGeometry x="60" y="760" width="330" height="190" as="geometry"/></mxCell><mxCell id="billing" value="&lt;b&gt;Биллинг&lt;/b&gt;&lt;br&gt;[Внешняя legacy-система]&lt;br&gt;Данные абонента, показания, начисления, задолженность, данные о поверке. Доступ — только через собственный внешний XML-RPC API" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#78909C;strokeColor=#546E7A;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1"><mxGeometry x="440" y="760" width="310" height="190" as="geometry"/></mxCell><mxCell id="tickets" value="&lt;b&gt;Микросервис обращений&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;Регистрация обращений абонентов (поверка, подключение, приём документов). Из него обращения читают подрядчики и пайплайн дообучения модели (источник 3, раздел 29)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#78909C;strokeColor=#546E7A;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1"><mxGeometry x="800" y="760" width="330" height="190" as="geometry"/></mxCell><mxCell id="dispatch" value="&lt;b&gt;Диспетчерская система&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;Аварийные заявки, near real-time (источник 7, раздел 29). Этап 1 — чтение данных по авариям для ответа. Этап 2 — передача аварийной заявки после подтверждения (HITL)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#78909C;strokeColor=#546E7A;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1"><mxGeometry x="1180" y="760" width="350" height="190" as="geometry"/></mxCell><mxCell id="e1" value="Вопросы, ответ, источники,&lt;br&gt;рекомендации; подтверждение&lt;br&gt;операций Этапа 2&lt;br&gt;[HTTPS, AI-виджет в ЛК]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#37474F;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.222;" parent="1" source="person" target="ai" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="180"/><mxPoint x="520" y="340"/></Array></mxGeometry></mxCell><mxCell id="e2" value="Работает в личном кабинете,&lt;br&gt;вход по SSO [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#37474F;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="person" target="lk" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="10" as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="Проверка сессии SSO, профиль&lt;br&gt;и контекст абонента [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#37474F;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.555;" parent="1" source="lk" target="ai" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="450"/><mxPoint x="520" y="400"/></Array></mxGeometry></mxCell><mxCell id="e4" value="Генерация ответа по обезличенному&lt;br&gt;промпту (ПДн удалены в LLM Gateway)&lt;br&gt;[External API]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#37474F;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="ai" target="llm" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint y="-45" as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="Забор документов для индексации RAG&lt;br&gt;[файловый доступ, только чтение]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#37474F;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.077;exitY=1;entryX=0.5;entryY=0;" parent="1" source="ai" target="kb" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="560"/><mxPoint x="225" y="560"/></Array></mxGeometry></mxCell><mxCell id="e6" value="Этап 1 — чтение данных абонента;&lt;br&gt;Этап 2 — запись после подтверждения (HITL)&lt;br&gt;[внешний XML-RPC API Биллинга]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#37474F;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.308;exitY=1;entryX=0.5;entryY=0;" parent="1" source="ai" target="billing" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="600"/><mxPoint x="595" y="600"/></Array><mxPoint y="15" as="offset"/></mxGeometry></mxCell><mxCell id="e7" value="Этап 2 — регистрация обращения&lt;br&gt;после подтверждения [REST API]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#37474F;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.587;exitY=1;entryX=0.5;entryY=0;" parent="1" source="ai" target="tickets" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Этап 1 — чтение данных по авариям;&lt;br&gt;Этап 2 — передача аварийной заявки&lt;br&gt;после подтверждения [REST API]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#37474F;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.846;exitY=1;entryX=0.5;entryY=0;" parent="1" source="ai" target="dispatch" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="640"/><mxPoint x="1355" y="640"/></Array></mxGeometry></mxCell><mxCell id="annotator" value="&lt;b&gt;Annotator&lt;/b&gt;&lt;br&gt;[Техническая роль — IAM]&lt;br&gt;Golden Set, валидация ответов, разметка спорных кейсов, оценка качества RAG" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#455A64;strokeColor=#263238;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=1;dashPattern=6 4;" parent="1" vertex="1"><mxGeometry x="900" y="120" width="280" height="130" as="geometry"/></mxCell><mxCell id="datascientist" value="&lt;b&gt;Data Scientist&lt;/b&gt;&lt;br&gt;[Техническая роль — IAM]&lt;br&gt;Анализ логов, метрики RAG (recall / precision), подготовка данных для дообучения" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#455A64;strokeColor=#263238;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=1;dashPattern=6 4;" parent="1" vertex="1"><mxGeometry x="1210" y="120" width="280" height="130" as="geometry"/></mxCell><mxCell id="e9" value="Готовит Golden Set, валидирует ответы,&lt;br&gt;размечает спорные кейсы, оценивает качество RAG" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#37474F;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.65;entryY=0;" parent="1" source="annotator" target="ai" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="260"/></Array></mxGeometry></mxCell><mxCell id="e10" value="Анализирует логи и метрики RAG,&lt;br&gt;готовит данные для дообучения" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#37474F;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.9;entryY=0;" parent="1" source="datascientist" target="ai" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="280"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>