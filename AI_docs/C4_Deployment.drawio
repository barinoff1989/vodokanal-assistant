овое хранилище: Word, реестр договоров, формы]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8A9BA8;strokeColor=#5F7182;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="2300" y="740" width="400" height="80" as="geometry"/></mxCell><mxCell id="note_stubs" value="На разработке и демо все пять систем заменяются локальными СУБД с синтетическими данными, повторяющими структуру CSV-примеров (код-шаг 0 плана сборки)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=#D9A400;fontColor=#7A5C00;fontSize=9;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2300" y="840" width="400" height="90" as="geometry"/></mxCell><mxCell id="legend" value="Легенда" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D4DE;align=left;verticalAlign=top;spacingTop=6;spacingLeft=12;fontSize=11;fontStyle=1;fontColor=#16324F;" parent="1" vertex="1"><mxGeometry x="2260" y="1000" width="480" height="210" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;" parent="1" vertex="1"><mxGeometry x="2284" y="1032" width="28" height="16" as="geometry"/></mxCell><mxCell id="lg1t" value="Контейнеры приложения (ai-app)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="2322" y="1030" width="400" height="20" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D99C00;strokeColor=#A67C00;" parent="1" vertex="1"><mxGeometry x="2284" y="1058" width="28" height="16" as="geometry"/></mxCell><mxCell id="lg2t" value="GPU-инференс (namespace gpu)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="2322" y="1056" width="400" heig