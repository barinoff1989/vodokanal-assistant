<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.0.3 Chrome/140.0.7339.249 Electron/38.7.0 Safari/537.36" version="29.0.3"><diagram id="deploy2" name="Deployment View MVP v2"><mxGraphModel dx="1028" dy="611" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Deployment View — MVP в проде (Этап 1)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#16324F;" parent="1" vertex="1"><mxGeometry x="100" y="20" width="1000" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Основная модель — внешняя (GigaChat Pro, ADR-002); собственный GPU — только эмбеддинги и реранкер. Изоляция GPU (F7) решена окном обслуживания 02:00–05:00. Биллинг, ЛК, микросервис обращений, диспетчерская и файловое хранилище БЗ физически внутри закрытой сети водоканала — снаружи недоступны ни на разработке, ни на демо." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6B7B;" parent="1" vertex="1"><mxGeometry x="100" y="58" width="2000" height="44" as="geometry"/></mxCell><mxCell id="person" value="&lt;b&gt;Абонент&lt;/b&gt;&lt;br&gt;[Персона]&lt;br&gt;Браузер ЛК" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#16324F;strokeColor=#0E2233;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=6;shadow=0;" parent="1" vertex="1"><mxGeometry x="140" y="120" width="260" height="90" as="geometry"/></mxCell><mxCell id="llmprov" value="&lt;b&gt;LLM Provider&lt;/b&gt;&lt;br&gt;[Внешний SaaS]&lt;br&gt;GigaChat Pro — управляемый API на территории РФ (152-ФЗ, ADR-002)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#8A9BA8;strokeColor=#5F7182;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="2260" y="120" width="420" height="110" as="geometry"/></mxCell><mxCell id="k8s" value="Kubernetes (k8s) cluster — контур водоканала · Helm-релизы, RBAC, NetworkPolicy" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#2E6DA4;strokeWidth=2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;fontSize=13;fontStyle=1;fontColor=#16324F;" parent="1" vertex="1"><mxGeometry x="100" y="300" width="1920" height="1220" as="geometry"/></mxCell><mxCell id="ns_platform" value="namespace: platform — node pool: general (CPU)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fillOpacity=0;strokeColor=#9BB8D3;dashed=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#3A6EA5;" parent="1" vertex="1"><mxGeometry x="120" y="330" width="1880" height="130" as="geometry"/></mxCell><mxCell id="ingress" value="&lt;b&gt;Ingress Controller&lt;/b&gt;&lt;br&gt;[nginx, Deployment]&lt;br&gt;TLS-терминация, маршрут /ai*, sticky для SSE" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#5B6B7C;strokeColor=#3E4C59;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="140" y="340" width="320" height="110" as="geometry"/></mxCell><mxCell id="certman" value="&lt;b&gt;cert-manager&lt;/b&gt;&lt;br&gt;[Deployment]&lt;br&gt;Выпуск и ротация TLS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#5B6B7C;strokeColor=#3E4C59;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="520" y="340" width="320" height="110" as="geometry"/></mxCell><mxCell id="vault" value="&lt;b&gt;Vault&lt;/b&gt;&lt;br&gt;[StatefulSet]&lt;br&gt;Секреты: токен LLM-провайдера, креды Биллинга, X-Internal-Token" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#5B6B7C;strokeColor=#3E4C59;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="900" y="340" width="320" height="110" as="geometry"/></mxCell><mxCell id="netpol" value="&lt;b&gt;NetworkPolicy + egress-gateway&lt;/b&gt;&lt;br&gt;Единственный разрешённый выход наружу — LLM Provider; остальное — только внутрь закрытой сети" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#5B6B7C;strokeColor=#3E4C59;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="1280" y="340" width="320" height="110" as="geometry"/></mxCell><mxCell id="backup" value="&lt;b&gt;CronJob: backup&lt;/b&gt;&lt;br&gt;[расписание 0 3 * * *]&lt;br&gt;Дампы Postgres, снапшоты Qdrant → S3/MinIO" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#27AE60;strokeColor=#1B7A43;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="1660" y="340" width="320" height="110" as="geometry"/></mxCell><mxCell id="ns_aiapp" value="namespace: ai-app — node pool: general (CPU), HPA по CPU и RPS" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fillOpacity=0;strokeColor=#9BB8D3;dashed=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#3A6EA5;" parent="1" vertex="1"><mxGeometry x="120" y="550" width="1880" height="160" as="geometry"/></mxCell><mxCell id="widget" value="&lt;b&gt;ai-widget&lt;/b&gt;&lt;br&gt;[Deployment, 2 реплики]&lt;br&gt;Статика React + Node-SSR, встраивается в ЛК" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="140" y="560" width="320" height="140" as="geometry"/></mxCell><mxCell id="backend" value="&lt;b&gt;backend&lt;/b&gt;&lt;br&gt;[Deployment, 3 реплики + HPA]&lt;br&gt;API Gateway / Backend: retrieval, routing, SSE-стрим. PodDisruptionBudget: minAvailable 2" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="520" y="560" width="320" height="140" as="geometry"/></mxCell><mxCell id="llmgw" value="&lt;b&gt;llm-gateway&lt;/b&gt;&lt;br&gt;[Deployment, 2 реплики + HPA]&lt;br&gt;PII Sanitizer, Guardrails, Quota Manager. Секреты провайдера — из Vault" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="900" y="560" width="320" height="140" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;agent-orchestrator&lt;/b&gt;&lt;br&gt;[Deployment, 2 реплики + HPA]&lt;br&gt;FSM, tool-calling, HITL-гейты" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="1280" y="560" width="320" height="140" as="geometry"/></mxCell><mxCell id="stage2" value="&lt;b&gt;billing-adapter · inquiry-service · doc-generator&lt;/b&gt;&lt;br&gt;[Deployment, Этап 2 — не разворачиваются на MVP]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="1660" y="560" width="320" height="140" as="geometry"/></mxCell><mxCell id="ns_gpu" value="namespace: gpu — 1× GPU-узел, taint nvidia.com/gpu-present:NoSchedule, nodeSelector pool=gpu" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF9EC;fillOpacity=60;strokeColor=#D9A400;dashed=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#A67C00;" parent="1" vertex="1"><mxGeometry x="120" y="780" width="1880" height="280" as="geometry"/></mxCell><mxCell id="embinf" value="&lt;b&gt;embedding-inference&lt;/b&gt;&lt;br&gt;[Deployment, GPU, 1 реплика]&lt;br&gt;BGE-M3: online-ретривал Backend + batch ETL — общий сервис (находка F7)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D99C00;strokeColor=#A67C00;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="140" y="800" width="320" height="120" as="geometry"/></mxCell><mxCell id="rerinf" value="&lt;b&gt;reranker-inference&lt;/b&gt;&lt;br&gt;[Deployment, GPU, 1 реплика]&lt;br&gt;BGE-reranker-v2-m3: online top_k=20 → top_n=3 и offline-отбор" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D99C00;strokeColor=#A67C00;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="520" y="800" width="320" height="120" as="geometry"/></mxCell><mxCell id="etl" value="&lt;b&gt;CronJob: etl-index&lt;/b&gt;&lt;br&gt;[Celery Beat + воркеры, 0 2 * * *]&lt;br&gt;Окно 02:00–05:00, activeDeadlineSeconds = 10800, concurrencyPolicy: Forbid" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#27AE60;strokeColor=#1B7A43;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="900" y="800" width="320" height="120" as="geometry"/></mxCell><mxCell id="cacheref" value="&lt;b&gt;CronJob: profile-cache-refresh&lt;/b&gt;&lt;br&gt;[CronJob, раздел 30]&lt;br&gt;Материализация кэша профиля абонента. GPU не использует" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#27AE60;strokeColor=#1B7A43;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="1280" y="800" width="320" height="120" as="geometry"/></mxCell><mxCell id="note_f7" value="&lt;b&gt;РЕШЕНИЕ F7&lt;/b&gt; — окно обслуживания (единственный P0 проекта, открыт с версии 4.0): забор документов 4 ч + полный реиндекс. Окно 02:00–05:00, activeDeadlineSeconds = 10800 — жёсткая граница. Не успели — job прерывается, курсор и контрольные суммы в Sync State (ист. 14), продолжение в следующем окне. Индекс не повреждается: alias переключается blue-green только после полного успеха. Delta-индексация днём — малыми порциями, нагрузка на GPU низкая. Контроль: Saturation (раздел 37), GPU по workload = etl-worker / llm-inference. Полная изоляция невозможна: свежие документы попадают в индекс с задержкой до окна. Пересмотр — если data-объём перестанет укладываться в окно (разделение GPU-пула)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=#D9A400;strokeWidth=1;fontColor=#7A5C00;fontSize=9;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1660" y="790" width="320" height="260" as="geometry"/></mxCell><mxCell id="ns_data" value="namespace: ai-data — node pool: data (CPU + локальные NVMe), PersistentVolume на каждом StatefulSet" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fillOpacity=0;strokeColor=#9BB8D3;dashed=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#3A6EA5;" parent="1" vertex="1"><mxGeometry x="120" y="1140" width="1880" height="160" as="geometry"/></mxCell><mxCell id="qdrant" value="&lt;b&gt;qdrant&lt;/b&gt;&lt;br&gt;[StatefulSet, PVC: NVMe]&lt;br&gt;HNSW m=16 / ef=128, blue-green alias при реиндексе" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1"><mxGeometry x="140" y="1150" width="320" height="130" as="geometry"/></mxCell><mxCell id="postgres" value="&lt;b&gt;postgres&lt;/b&gt;&lt;br&gt;[StatefulSet, PVC]&lt;br&gt;Session State Store, Sync State, materialized view профиля" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1"><mxGeometry x="520" y="1150" width="320" height="130" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b&gt;redis&lt;/b&gt;&lt;br&gt;[StatefulSet, PVC]&lt;br&gt;Quota Store (рейт-лимиты) + быстрый слой кэша профиля" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1"><mxGeometry x="900" y="1150" width="320" height="130" as="geometry"/></mxCell><mxCell id="clickhouse" value="&lt;b&gt;clickhouse&lt;/b&gt;&lt;br&gt;[StatefulSet, PVC]&lt;br&gt;Телеметрия: токены, стоимость, latency, quality_report" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1"><mxGeometry x="1280" y="1150" width="320" height="130" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;S3 / MinIO&lt;/b&gt;&lt;br&gt;[StatefulSet или внешний]&lt;br&gt;Data Lake Raw Zone: корпус, бэкапы, готовые документы обращений" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#2F80C3;strokeColor=#1F5C8B;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1"><mxGeometry x="1660" y="1150" width="320" height="130" as="geometry"/></mxCell><mxCell id="ns_obs" value="namespace: observability — node pool: general" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fillOpacity=0;strokeColor=#9BB8D3;dashed=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#3A6EA5;" parent="1" vertex="1"><mxGeometry x="120" y="1360" width="1880" height="130" as="geometry"/></mxCell><mxCell id="prom" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;[StatefulSet]&lt;br&gt;assistant_ttft_seconds, guardrails_blocked_total, GPU по workload" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#5B6B7C;strokeColor=#3E4C59;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="140" y="1370" width="320" height="100" as="geometry"/></mxCell><mxCell id="grafana" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;[Deployment]&lt;br&gt;Дашборды раздел 37: 5 Golden Signals + 8 AI-метрик" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#5B6B7C;strokeColor=#3E4C59;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="520" y="1370" width="320" height="100" as="geometry"/></mxCell><mxCell id="loki" value="&lt;b&gt;Loki&lt;/b&gt;&lt;br&gt;[StatefulSet]&lt;br&gt;Логи. Сырые ПДн не логируются — только pii_report (правило 4.2)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#5B6B7C;strokeColor=#3E4C59;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="900" y="1370" width="320" height="100" as="geometry"/></mxCell><mxCell id="alertman" value="&lt;b&gt;Alertmanager&lt;/b&gt;&lt;br&gt;[Deployment]&lt;br&gt;9 алертов: от «Утечка ПДн в ответе» до «ИБ + деградация»" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#5B6B7C;strokeColor=#3E4C59;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="1280" y="1370" width="320" height="100" as="geometry"/></mxCell><mxCell id="note_alerts" value="&lt;b&gt;ОТКРЫТО:&lt;/b&gt; sizing MVP в проде не посчитан (раздел 39.3). Посчитаны только локальный прототип (39.2, без GPU) и self-hosted тираж (39.1, A100 80GB). Число реплик и класс GPU-узла — ПРЕДПОЛОЖЕНИЕ: нужен расчёт под реальный λ (раздел 28.1)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=#D9A400;fontColor=#7A5C00;fontSize=9;align=left;verticalAlign=top;spacing=10;" par